// QueryEndpoint query endpoint
func (s *Registry) QueryEndpoint(res http.ResponseWriter, req *http.Request) {
	type queryResult struct {
		commonDef.Result
		Endpoint *casModel.EndpointView `json:"endpoint"`
	}

	result := &queryResult{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		_, value := net.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			log.Printf("update endpoint failed, illegal id, id:%s, err:%s", value, err.Error())
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		endpointView, endpointErr := s.queryEndpoint(curSession, id)
		if endpointErr != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "参数非法"
		}

		result.Endpoint = endpointView
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Registry) updateEndpoint(currentSession commonSession.Session, endpoint *casModel.EndpointView) (ret *casModel.EndpointView, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	sessionInfo := currentSession.GetSessionInfo()
	clnt.BindSession(sessionInfo)
	ret, err = clnt.UpdateEndpoint(endpoint)
	return
}

// UpdateEndpoint update endpoint
func (s *Registry) UpdateEndpoint(res http.ResponseWriter, req *http.Request) {
	param := map[string]int{}
	result := &commonDef.Result{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		_, value := net.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			log.Printf("update endpoint failed, illegal id, id:%s, err:%s", value, err.Error())
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		endpointView, endpointErr := s.queryEndpoint(curSession, id)
		if endpointErr != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "参数非法"
			break
		}

		err = net.ParseJSONBody(req, &param)
		if err != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "参数非法"
			break
		}
		status, ok := param["status"]
		if ok {
			endpointView.Status = casModel.GetStatus(status)
		}
		privateGroup, ok := param["privateGroup"]
		if ok {
			endpointView.PrivateGroup = &casModel.PrivateGroupLite{ID: privateGroup}
		}

		_, err = s.updateEndpoint(curSession, endpointView)
		if err != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = "更新信息出错,更新账号信息失败"
			break
		}

		result.ErrorCode = commonDef.Success

		memo := fmt.Sprintf("更新账号%s", endpointView.Endpoint)
		s.writelog(res, req, memo)
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}
