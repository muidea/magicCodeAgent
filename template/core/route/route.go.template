// Registry 路由信息
type Registry struct {
	commonHandler        handler.CommonHandler
	sessionRegistry      commonSession.Registry
	privateRouteRegistry routeToolkit.PrivateRegistry
	casRouteRegistry     routeToolkit.CasRegistry

	casService *service.Cas
}

// NewRoute create route
func NewRoute(
	sessionRegistry commonSession.Registry,
	commonHandler handler.CommonHandler,
	casService *service.Cas,
) *Registry {
	route := &Registry{
		sessionRegistry: sessionRegistry,
		commonHandler:   commonHandler,
		casService:      casService,
	}

	route.privateRouteRegistry = routeToolkit.NewPrivateRegistry(route)
	route.casRouteRegistry = routeToolkit.NewCasRegistry(route)

	return route
}

// Login login account
func (s *Registry) Login(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	result := &casCommon.LoginResult{}
	for {
		param := &casCommon.LoginParam{}
		err := net.ParseJSONBody(req, param)
		if err != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		if param.Account == "" || param.Password == "" {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数,输入参数为空"
			break
		}

		loginEntity, loginSession, loginErr := s.casService.Login(curSession, param.Account, param.Password)
		if loginErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = loginErr.Error()
			break
		}

		result.Entity = loginEntity
		result.SessionInfo = loginSession
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// Logout logout account
func (s *Registry) Logout(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	result := &casCommon.LogoutResult{}
	for {
		logoutSession, logoutErr := s.casService.Logout(curSession)
		if logoutErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = logoutErr.Error()
			break
		}

		result.SessionInfo = logoutSession
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// ConfirmEndpoint verify endpoint
func (s *Registry) ConfirmEndpoint(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	result := &casCommon.ConfirmResult{}
	for {
		authToken := req.URL.Query().Get("authToken")
		identifyID := req.URL.Query().Get("identifyID")
		if authToken == "" || identifyID == "" {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "无效参数"
			break
		}

		confirmEntity, confirmSession, confirmErr := s.casService.ConfirmEndpoint(curSession, authToken, identifyID)
		if confirmErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = confirmErr.Error()
			break
		}

		result.Entity = confirmEntity
		result.SessionInfo = confirmSession
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

