// Registry 路由信息
type Registry struct {
	commonHandler        handler.CommonHandler
	sessionRegistry      commonSession.Registry
	privateRouteRegistry routeToolkit.PrivateRegistry
	casRouteRegistry     routeToolkit.CasRegistry

	userService string
	casService  string
	fileService string
}

// NewRoute create route
func NewRoute(
	sessionRegistry commonSession.Registry,
	commonHandler handler.CommonHandler,
) *Registry {
	route := &Registry{
		sessionRegistry: sessionRegistry,
		commonHandler:   commonHandler,
		casService:      config.CasService(),
		userService:     config.UserService(),
		fileService:     config.FileService(),
	}

	route.privateRouteRegistry = routeToolkit.NewPrivateRegistry(route)
	route.casRouteRegistry = routeToolkit.NewCasRegistry(route)

	return route
}

// Login login account
func (s *Registry) Login(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	ctx := commonCommon.NewSessionContext(nil)
	curSession.GetContextInfo(ctx)
	ctxSession := ctx.GetSessionInfo()

	result := &casCommon.LoginResult{}
	for {
		param := &casCommon.LoginParam{}
		err := net.ParseJSONBody(req, param)
		if err != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		if param.Account == "" || param.Password == "" {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数,输入参数为空"
			break
		}

		casClient := casClient.NewClient(s.casService)
		defer casClient.Release()
		if ctxSession == nil {
			sessionInfo := curSession.GetSessionInfo()
			casClient.BindSession(sessionInfo)
			entityPtr, sessionInfo, loginErr := casClient.LoginAccount(param.Account, param.Password)
			if loginErr != nil {
				log.Printf("login account failed, err:%s", loginErr.Error())
				return
			}

			result.Entity = entityPtr
			result.SessionInfo = sessionInfo
			curSession.SetSessionInfo(sessionInfo)
			curSession.SetOption(commonCommon.AuthAccount, entityPtr)
		} else {
			casClient.BindSession(ctxSession)
			entityPtr, verifyErr := casClient.VerifyAccount(param.Account, param.Password)
			if verifyErr != nil {
				log.Printf("verify account failed, err:%s", verifyErr.Error())
				return
			}

			result.Entity = entityPtr
			result.SessionInfo = ctxSession
		}
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// Logout logout account
func (s *Registry) Logout(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	ctx := commonCommon.NewSessionContext(nil)
	curSession.GetContextInfo(ctx)
	ctxSession := ctx.GetSessionInfo()

	result := &casCommon.LogoutResult{}
	for {
		sessionInfo := curSession.GetSessionInfo()
		if ctxSession == nil {
			casClient := casClient.NewClient(s.casService)
			defer casClient.Release()
			casClient.BindSession(sessionInfo)

			logoutSession, logoutErr := casClient.LogoutAccount()
			if logoutErr != nil {
				log.Printf("logout account failed, err:%s", logoutErr.Error())
				result.ErrorCode = commonDef.Failed
				result.Reason = "登出失败"
				break
			}

			sessionInfo = logoutSession
			curSession.SetSessionInfo(sessionInfo)
			curSession.RemoveOption(commonCommon.AuthAccount)
		}

		sessionInfo.Token = ""
		result.SessionInfo = sessionInfo
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// ConfirmEndpoint verify endpoint
func (s *Registry) ConfirmEndpoint(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	ctx := commonCommon.NewSessionContext(nil)
	curSession.GetContextInfo(ctx)
	ctxSession := ctx.GetSessionInfo()

	result := &casCommon.ConfirmResult{}
	for {
		authToken := req.URL.Query().Get("authToken")
		identifyID := req.URL.Query().Get("identifyID")

		casClient := casClient.NewClient(s.casService)
		defer casClient.Release()

		if ctxSession == nil {
			sessionInfo := curSession.GetSessionInfo()
			casClient.BindSession(sessionInfo)
			entityPtr, sessionInfo, confirmErr := casClient.ConfirmEndpoint(identifyID, authToken)
			if confirmErr != nil {
				log.Printf("confirm endpoint failed, err:%s", confirmErr.Error())
				return
			}

			result.Entity = entityPtr
			result.SessionInfo = sessionInfo
			curSession.SetSessionInfo(sessionInfo)
			curSession.SetOption(commonCommon.AuthAccount, entityPtr)
		} else {
			casClient.BindSession(ctxSession)
			entityPtr, confirmErr := casClient.VerifyEndpoint(identifyID, authToken)
			if confirmErr != nil {
				log.Printf("verify endpoint failed, err:%s", confirmErr.Error())
				return
			}

			result.Entity = entityPtr
			result.SessionInfo = ctxSession
		}

		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// RefreshStatus refresh commonSession status
func (s *Registry) RefreshStatus(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	ctx := casCommon.NewEntityContext(nil)
	curSession.GetContextInfo(ctx)
	ctxEntity := ctx.GetEntity()

	sessionInfo := curSession.GetSessionInfo()
	result := &casCommon.RefreshResult{}
	for {
		casClient := casClient.NewClient(s.casService)
		defer casClient.Release()
		casClient.BindSession(sessionInfo)

		if ctxEntity == nil {
			sessionEntity, sessionInfo, sessionErr := casClient.RefreshSession()
			if sessionErr != nil {
				result.ErrorCode = commonDef.Failed
				result.Reason = "刷新会话失败，非法权限"
				break
			}
			curSession.SetSessionInfo(sessionInfo)
			curSession.SetOption(commonCommon.AuthAccount, sessionEntity)
			result.Entity = sessionEntity
			result.SessionInfo = sessionInfo
		} else {
			if ctxEntity.EType == casModel.AccountType {
				accountPtr, accountErr := casClient.QueryAccount(ctxEntity.EID)
				if accountErr != nil {
					result.ErrorCode = commonDef.Failed
					result.Reason = "刷新会话失败，非法权限"
					break
				}

				result.Entity = accountPtr.Entity()
				result.SessionInfo = sessionInfo
				break
			}
			if ctxEntity.EType == casModel.EndpointType {
				endpointPtr, endpointErr := casClient.QueryEndpoint(ctxEntity.EID)
				if endpointErr != nil {
					result.ErrorCode = commonDef.Failed
					result.Reason = "刷新会话失败，非法权限"
					break
				}

				result.Entity = endpointPtr.Entity()
				result.SessionInfo = sessionInfo
				break
			}

			result.ErrorCode = commonDef.Failed
			result.Reason = "刷新会话失败，非法认证"
		}

		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// Verify verify current commonSession
func (s *Registry) Verify(res http.ResponseWriter, req *http.Request) (err error) {
	curSession := s.sessionRegistry.GetSession(res, req)

	sessionInfo := curSession.GetSessionInfo()

	casClient := casClient.NewClient(s.casService)
	defer casClient.Release()
	casClient.BindSession(sessionInfo)

	sessionEntity, sessionInfo, sessionErr := casClient.RefreshSession()
	if sessionErr != nil {
		err = sessionErr
		log.Printf("verify current commonSession failed, err:%s", sessionErr.Error())
		return
	}

	curSession.SetSessionInfo(sessionInfo)
	curSession.SetOption(commonCommon.AuthAccount, sessionEntity)

	return
}

// VerifyPrivate verify private
func (s *Registry) VerifyPrivate(res http.ResponseWriter, req *http.Request) (ret *casModel.PrivateGroupLite, err error) {
	curSession := s.sessionRegistry.GetSession(res, req)

	sessionInfo := curSession.GetSessionInfo()

	ctx := casCommon.NewEntityContext(nil)
	curSession.GetContextInfo(ctx)
	ctxEntity := ctx.GetEntity()

	casClient := casClient.NewClient(s.casService)
	defer casClient.Release()
	casClient.BindSession(sessionInfo)

	var entityPtr *casModel.Entity
	if ctxEntity == nil {
		authPtr, authOK := curSession.GetOption(commonCommon.AuthAccount)
		if !authOK {
			err = fmt.Errorf("illegal authority")
			return
		}

		entityPtr = authPtr.(*casModel.Entity)
	} else {
		entityPtr = ctxEntity
	}

	privatePtr, verifyErr := casClient.VerifyPrivate(entityPtr)
	if verifyErr != nil {
		err = verifyErr
		log.Printf("verify privateGroup failed, err:%s", verifyErr.Error())
		return
	}

	ret = privatePtr
	return
}

// Handle middleware handler
func (s *Registry) Handle(ctx engine.RequestContext, res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	sessionInfo := curSession.GetSessionInfo()
	sessionInfo.Scope = commonCommon.ShareSession

	values := req.URL.Query()
	values = sessionInfo.Encode(values)
	req.URL.RawQuery = values.Encode()

	ctx.Next()
}

// RegisterRoute 注册路由
func (s *Registry) RegisterRoute(router engine.Router) {

	s.casRouteRegistry.AddHandler(common.QueryOperateLogURL, "GET", s.QueryOperateLog)

	// account login,logout,verify,changepassword
	//---------------------------------------------------------------------------------------
	loginRoute := engine.CreateRoute(common.LoginAccountURL, "POST", s.Login)
	router.AddRoute(loginRoute, s)

	logoutRoute := engine.CreateRoute(common.LogoutAccountURL, "DELETE", s.Logout)
	s.casRouteRegistry.AddRoute(logoutRoute, s)

	verifyEndpointRoute := engine.CreateRoute(common.ConfirmEndpointURL, "GET", s.ConfirmEndpoint)
	router.AddRoute(verifyEndpointRoute, s)

	s.casRouteRegistry.AddHandler(common.RefreshStatusURL, "GET", s.RefreshStatus)

	createAccountURL := net.JoinURL(s.casService, casCommon.CreateAccountURL)
	createAccountRoute := engine.CreateProxyRoute(common.CreateAccountURL, "POST", createAccountURL, true)
	s.casRouteRegistry.AddRoute(createAccountRoute, s)

	changePasswordURL := net.JoinURL(s.casService, casCommon.ChangePasswordURL)
	changePasswordRoute := engine.CreateProxyRoute(common.UpdateAccountPasswordURL, "PUT", changePasswordURL, true)
	s.casRouteRegistry.AddRoute(changePasswordRoute, s)

	// update account,query account,delete account
	//---------------------------------------------------------------------------------------
	s.privateRouteRegistry.AddHandler("/api/v1/account/query/all/", "GET", casModel.ReadPrivate, s.QueryAllAccount)
	s.privateRouteRegistry.AddHandler("/api/v1/account/query/:id", "GET", casModel.ReadPrivate, s.QueryAccount)
	s.privateRouteRegistry.AddHandler("/api/v1/account/delete/:id", "DELETE", casModel.DeletePrivate, s.DeleteAccount)
	s.privateRouteRegistry.AddHandler("/api/v1/account/update/:id", "PUT", casModel.WritePrivate, s.UpdateAccount)

	// update endpoint,query endpoint,delete endpoint
	//---------------------------------------------------------------------------------------
	s.privateRouteRegistry.AddHandler("/api/v1/endpoint/query/all/", "GET", casModel.ReadPrivate, s.QueryAllEndpoint)
	s.privateRouteRegistry.AddHandler("/api/v1/endpoint/query/:id", "GET", casModel.ReadPrivate, s.QueryEndpoint)
	s.privateRouteRegistry.AddHandler("/api/v1/endpoint/create/", "POST", casModel.WritePrivate, s.CreateEndpoint)
	s.privateRouteRegistry.AddHandler("/api/v1/endpoint/delete/:id", "DELETE", casModel.DeletePrivate, s.DeleteEndpoint)
	s.privateRouteRegistry.AddHandler("/api/v1/endpoint/update/:id", "PUT", casModel.WritePrivate, s.UpdateEndpoint)

	// private
	//---------------------------------------------------------------------------------------
	s.privateRouteRegistry.AddHandler("/api/v1/private/query/", "GET", casModel.ReadPrivate, s.QueryPrivateGroup)
	s.privateRouteRegistry.AddHandler("/api/v1/private/save/", "POST", casModel.WritePrivate, s.SavePrivateGroup)
	s.privateRouteRegistry.AddHandler("/api/v1/private/destory/", "GET", casModel.DeletePrivate, s.DestoryPrivateGroup)

	// upload file
	//---------------------------------------------------------------------------------------
	uploadFileURL := net.JoinURL(s.fileService, "/file/upload/")
	uploadFileRoute := engine.CreateProxyRoute("/api/v1/file/upload/", "POST", uploadFileURL, true)
	router.AddRoute(uploadFileRoute, s)

	viewFileURL := net.JoinURL(s.fileService, "/file/download/")
	viewFileRoute := engine.CreateProxyRoute("/api/v1/file/view/", "GET", viewFileURL, true)
	router.AddRoute(viewFileRoute, s)

	s.privateRouteRegistry.RegisterRoute(router)

	s.casRouteRegistry.RegisterRoute(router)
}

// QueryOperateLog query operate log
func (s *Registry) QueryOperateLog(res http.ResponseWriter, req *http.Request) {
	result := &common.QueryAllOpertateLogResult{}
	for {
		pageFilter := &util.PageFilter{}
		if !pageFilter.Decode(req) {
			pageFilter = nil
		}

		logs, logTotal, logsErr := s.commonHandler.QueryOpLog(pageFilter)
		if logsErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = logsErr.Error()
			break
		}

		result.Logs = logs
		result.Total = logTotal
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Registry) writelog(res http.ResponseWriter, req *http.Request, memo string) {
	address := net.GetHTTPRemoteAddress(req)
	account := ""
	curEntity, curErr := s.getCurrentEntity(res, req)
	if curErr == nil {
		account = curEntity.String()
	}

	_, logErr := s.commonHandler.WriteOpLog(account, address, memo)
	if logErr != nil {
		log.Printf("WriteOpLog failed, err:%s", logErr.Error())
	}
}

func (s *Registry) getCurrentEntity(res http.ResponseWriter, req *http.Request) (ret *casModel.Entity, err error) {
	curSession := s.sessionRegistry.GetSession(res, req)

	ctx := casCommon.NewEntityContext(nil)
	curSession.GetContextInfo(ctx)
	ctxEntity := ctx.GetEntity()

	if ctxEntity == nil {
		authVal, ok := curSession.GetOption(commonCommon.AuthAccount)
		if !ok {
			err = fmt.Errorf("无效权限,未通过验证")
			return
		}
		ret = authVal.(*casModel.Entity)
		return
	}

	ret = ctxEntity
	return
}
