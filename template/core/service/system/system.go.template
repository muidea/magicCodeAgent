// GetSystemInfo get system info
func (s *System) GetSystemInfo(res http.ResponseWriter, req *http.Request) {
	type getResult struct {
		commonDef.Result
		Menu []interface{} `json:"menu"`
	}

	result := &getResult{Menu: []interface{}{}}
	for {
		menuBuffer := bytes.NewBufferString(menu)
		menuContent, menuErr := ioutil.ReadAll(menuBuffer)
		if menuErr != nil {
			log.Printf("ioutil.ReadAll failed,err:%s", menuErr.Error())

			result.ErrorCode = commonDef.Failed
			result.Reason = "读取Menu数据失败"
		}

		err := json.Unmarshal(menuContent, &result.Menu)
		if err != nil {
			log.Printf("json.Unmarshal failed, err:%s", err.Error())

			result.ErrorCode = commonDef.Failed
			result.Reason = "读取Menu数据失败"
		}

		break
	}
	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// QueryOperateLog query operate log
func (s *System) QueryOperateLog(res http.ResponseWriter, req *http.Request) {
	result := &vmiCommon.QueryAllOpLogResult{}
	for {
		pageFilter := &util.PageFilter{}
		if !pageFilter.Decode(req) {
			pageFilter = nil
		}

		logs, logTotal, logsErr := s.commonHandler.QueryOpLog(pageFilter)
		if logsErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = logsErr.Error()
			break
		}

		result.Logs = logs
		result.Total = logTotal
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

