package service

import (
	"fmt"
	casClient "github.com/muidea/magicCas/client"
	casCommon "github.com/muidea/magicCas/common"
	casModel "github.com/muidea/magicCas/model"
	commonCommon "github.com/muidea/magicCommon/common"
	commonSession "github.com/muidea/magicCommon/session"
	"log"
)

type Cas struct {
	casService string
}

func NewCas(casService string) *Cas {
	return &Cas{casService: casService}
}

func (s *Cas) Login(curSession commonSession.Session, account, password string) (entityPtr *casModel.Entity, sessionInfo *commonCommon.SessionInfo, err error) {
	casClient := casClient.NewClient(s.casService)
	defer casClient.Release()

	ctx := commonCommon.NewSessionContext(nil)
	curSession.GetContextInfo(ctx)
	ctxSession := ctx.GetSessionInfo()
	if ctxSession == nil {
		casClient.BindSession(curSession.GetSessionInfo())
		loginEntity, loginSession, loginErr := casClient.LoginAccount(account, password)
		if loginErr != nil {
			err = loginErr
			log.Printf("login account failed, err:%s", err.Error())
			return
		}

		curSession.SetSessionInfo(loginSession)
		curSession.SetOption(commonCommon.AuthAccount, loginEntity)
		entityPtr = loginEntity
		sessionInfo = loginSession
		return
	}

	casClient.BindSession(ctxSession)
	verifyEntity, verifyErr := casClient.VerifyAccount(account, password)
	if verifyErr != nil {
		err = verifyErr
		log.Printf("verify account failed, err:%s", err.Error())
		return
	}

	entityPtr = verifyEntity
	sessionInfo = ctxSession

	return
}

func (s *Cas) Logout(curSession commonSession.Session) (sessionInfo *commonCommon.SessionInfo, err error) {
	ctx := commonCommon.NewSessionContext(nil)
	curSession.GetContextInfo(ctx)
	ctxSession := ctx.GetSessionInfo()

	sessionInfo = curSession.GetSessionInfo()
	if ctxSession == nil {
		casClient := casClient.NewClient(s.casService)
		defer casClient.Release()
		casClient.BindSession(sessionInfo)

		logoutSession, logoutErr := casClient.LogoutAccount()
		if logoutErr != nil {
			err = logoutErr
			log.Printf("logout account failed, err:%s", err.Error())
			return
		}

		sessionInfo = logoutSession
		curSession.SetSessionInfo(sessionInfo)
		curSession.RemoveOption(commonCommon.AuthAccount)
	} else {
		sessionInfo.Token = ""
	}

	return
}

func (s *Cas) ConfirmEndpoint(curSession commonSession.Session, authToken, identifyID string) (entityPtr *casModel.Entity, sessionInfo *commonCommon.SessionInfo, err error) {
	casClient := casClient.NewClient(s.casService)
	defer casClient.Release()

	ctx := commonCommon.NewSessionContext(nil)
	curSession.GetContextInfo(ctx)
	ctxSession := ctx.GetSessionInfo()
	if ctxSession == nil {
		casClient.BindSession(curSession.GetSessionInfo())
		confirmEntity, confirmSession, confirmErr := casClient.ConfirmEndpoint(identifyID, authToken)
		if confirmErr != nil {
			err = confirmErr
			log.Printf("confirm endpoint failed, err:%s", err.Error())
			return
		}

		curSession.SetSessionInfo(confirmSession)
		curSession.SetOption(commonCommon.AuthAccount, confirmEntity)
		entityPtr = confirmEntity
		sessionInfo = confirmSession
	} else {
		casClient.BindSession(ctxSession)
		verifyEntity, verifyErr := casClient.VerifyEndpoint(identifyID, authToken)
		if verifyErr != nil {
			err = verifyErr
			log.Printf("verify endpoint failed, err:%s", err.Error())
			return
		}

		entityPtr = verifyEntity
		sessionInfo = ctxSession
	}

	return
}

func (s *Cas) RefreshStatus(curSession commonSession.Session) (
	entityPtr *casModel.Entity,
	sessionInfo *commonCommon.SessionInfo,
	err error) {
	ctx := casCommon.NewEntityContext(nil)
	curSession.GetContextInfo(ctx)
	ctxEntity := ctx.GetEntity()

	sessionInfo = curSession.GetSessionInfo()
	casClient := casClient.NewClient(s.casService)
	defer casClient.Release()
	casClient.BindSession(sessionInfo)
	if ctxEntity == nil {
		refreshEntity, refreshSession, refreshErr := casClient.RefreshSession()
		if refreshErr != nil {
			err = refreshErr
			return
		}
		curSession.SetSessionInfo(refreshSession)
		curSession.SetOption(commonCommon.AuthAccount, refreshEntity)
		entityPtr = refreshEntity
		sessionInfo = refreshSession
		return
	}

	if ctxEntity.EType == casModel.AccountType {
		accountPtr, accountErr := casClient.QueryAccount(ctxEntity.EID)
		if accountErr != nil {
			err = accountErr
			return
		}

		entityPtr = accountPtr.Entity()
		return
	}

	if ctxEntity.EType == casModel.EndpointType {
		endpointPtr, endpointErr := casClient.QueryEndpoint(ctxEntity.EID)
		if endpointErr != nil {
			err = endpointErr
			return
		}

		entityPtr = endpointPtr.Entity()
		return
	}

	err = fmt.Errorf("illegal session")
	return
}

func (s *Cas) VerifyPrivate(curSession commonSession.Session) (ret *casModel.PrivateGroupLite, err error) {
	sessionInfo := curSession.GetSessionInfo()

	ctx := casCommon.NewEntityContext(nil)
	curSession.GetContextInfo(ctx)
	ctxEntity := ctx.GetEntity()

	casClient := casClient.NewClient(s.casService)
	defer casClient.Release()
	casClient.BindSession(sessionInfo)

	var entityPtr *casModel.Entity
	if ctxEntity == nil {
		authPtr, authOK := curSession.GetOption(commonCommon.AuthAccount)
		if !authOK {
			err = fmt.Errorf("illegal authority")
			return
		}

		entityPtr = authPtr.(*casModel.Entity)
	} else {
		entityPtr = ctxEntity
	}

	privatePtr, verifyErr := casClient.VerifyPrivate(entityPtr)
	if verifyErr != nil {
		err = verifyErr
		log.Printf("verify privateGroup failed, err:%s", verifyErr.Error())
		return
	}

	ret = privatePtr
	return
}

