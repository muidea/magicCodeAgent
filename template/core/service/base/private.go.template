package base

import (
	"encoding/json"
	"fmt"
	"net/http"
	"strconv"

	"github.com/muidea/magicCommon/foundation/net"

	casModel "github.com/muidea/magicCas/model"
	commonDef "github.com/muidea/magicCommon/def"
)

// QueryPrivateGroup query privateGroup
func (s *Base) QueryPrivateGroup(res http.ResponseWriter, req *http.Request) {
	type queryResult struct {
		commonDef.Result
		PrivateGroups []*casModel.PrivateGroupView `json:"privates"`
	}

	result := &queryResult{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		privateViewList, _, privateErr := s.casBiz.QueryPrivateGroup(curSession)
		if privateErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = fmt.Sprintf("查询权限组失败, %s", privateErr.Error())
			break
		}

		result.PrivateGroups = privateViewList
		break
	}
	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// QueryPrivateGroupByID query privateGroup by id
func (s *Base) QueryPrivateGroupByID(res http.ResponseWriter, req *http.Request) {
	type queryResult struct {
		commonDef.Result
		PrivateGroup *casModel.PrivateGroupView `json:"private"`
	}

	result := &queryResult{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		_, value := net.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		privateView, privateErr := s.casBiz.QueryPrivateGroupByID(curSession, id)
		if privateErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = fmt.Sprintf("查询权限组失败, %s", privateErr.Error())
			break
		}

		result.PrivateGroup = privateView
		break
	}
	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// CreatePrivateGroup create privateGroup
func (s *Base) CreatePrivateGroup(res http.ResponseWriter, req *http.Request) {
	type createParam struct {
		Name        string                  `json:"name"`
		Description string                  `json:"description"`
		Privates    []*casModel.PrivateItem `json:"privates"`
	}

	type createResult struct {
		commonDef.Result
		PrivateGroup *casModel.PrivateGroupView `json:"private"`
	}

	result := &createResult{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		param := &createParam{}
		err := net.ParseJSONBody(req, param)
		if err != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "保存权限组失败, 非法参数"
			break
		}
		if param.Name == "" {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "保存权限组失败, 无效参数"
			break
		}

		privateView, privateErr := s.casBiz.CreatePrivateGroup(curSession, param.Name, param.Description, param.Privates)
		if privateErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = fmt.Sprintf("保存权限组失败, %s", privateErr.Error())
			break
		}

		result.PrivateGroup = privateView

		memo := fmt.Sprintf("保存权限组%s", privateView.Name)
		s.writeLog(res, req, memo)
		break
	}
	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// DeletePrivateGroup delete privateGroup
func (s *Base) DeletePrivateGroup(res http.ResponseWriter, req *http.Request) {
	type deleteResult struct {
		commonDef.Result
		PrivateGroup *casModel.PrivateGroupView `json:"private"`
	}
	result := &deleteResult{}

	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		_, value := net.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		privateGroupPtr, privateGroupErr := s.casBiz.DeletePrivateGroup(curSession, id)
		if privateGroupErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = fmt.Sprintf("删除权限组失败, %s", privateGroupErr.Error())
			break
		}

		result.PrivateGroup = privateGroupPtr
		result.ErrorCode = commonDef.Success

		memo := fmt.Sprintf("删除权限组, Name:%s", privateGroupPtr.Name)
		s.writeLog(res, req, memo)
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}
