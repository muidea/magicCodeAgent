// DeleteNamespace delete namespace
func (s *Base) DeleteNamespace(res http.ResponseWriter, req *http.Request) {
	type deleteResult struct {
		commonDef.Result
		Namespace *casModel.NamespaceView `json:"namespace"`
	}
	result := &deleteResult{}

	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		_, value := net.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		namespace := s.getCurrentNamespace(res, req)
		namespacePtr, namespaceErr := s.casBiz.DeleteNamespace(curSession, id, namespace)
		if namespaceErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = fmt.Sprintf("删除Namespace失败, %s", namespaceErr.Error())
			break
		}

		result.Namespace = namespacePtr
		result.ErrorCode = commonDef.Success

		memo := fmt.Sprintf("删除Namespace, Name:%s", namespacePtr.Name)
		s.writeLog(res, req, memo)
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}
