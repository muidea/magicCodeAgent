	curSession := s.sessionRegistry.GetSession(res, req)

	result := &casCommon.RefreshResult{}
	for {
		refreshEntity, refreshSession, refreshErr := s.casBiz.RefreshStatus(curSession)
		if refreshErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = refreshErr.Error()
			break
		}

		curSession.SetSessionInfo(refreshSession)
		curSession.SetOption(commonCommon.AuthAccount, refreshEntity)
		curSession.Flush(res, req)

		result.Entity = refreshEntity
		result.SessionInfo = refreshSession
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// Verify verify current commonSession
func (s *Base) Verify(res http.ResponseWriter, req *http.Request) (err error) {
	curSession := s.sessionRegistry.GetSession(res, req)

	sessionEntity, sessionInfo, sessionErr := s.casBiz.RefreshStatus(curSession)
	if sessionErr != nil {
		err = sessionErr
		log.Printf("verify current commonSession failed, err:%s", sessionErr.Error())
		return
	}

	curSession.SetSessionInfo(sessionInfo)
	curSession.SetOption(commonCommon.AuthAccount, sessionEntity)
	curSession.Flush(res, req)

	return
}

// VerifyPrivate verify private
func (s *Base) VerifyPrivate(res http.ResponseWriter, req *http.Request) (ret *casModel.PrivateGroupLite, err error) {
	curSession := s.sessionRegistry.GetSession(res, req)

	ret, err = s.casBiz.VerifyPrivate(curSession)
	return
}

// Handle middleware handler
func (s *Base) Handle(ctx engine.RequestContext, res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	sessionInfo := curSession.GetSessionInfo()
	sessionInfo.Scope = commonCommon.ShareSession

	values := req.URL.Query()
	values = sessionInfo.Encode(values)
	req.URL.RawQuery = values.Encode()

	ctx.Next()
}

// RegisterHandler 注册路由
func (s *Base) RegisterHandler(router engine.Router) {
	// account login,logout,verify,change password
	//---------------------------------------------------------------------------------------
	loginRoute := engine.CreateRoute(common.LoginAccountURL, "POST", s.Login)
	router.AddRoute(loginRoute, s)

	logoutRoute := engine.CreateRoute(common.LogoutAccountURL, "DELETE", s.Logout)
	s.casRouteRegistry.AddRoute(logoutRoute, s)

	verifyEndpointRoute := engine.CreateRoute(common.ConfirmEndpointURL, "GET", s.ConfirmEndpoint)
	router.AddRoute(verifyEndpointRoute, s)

	s.casRouteRegistry.AddHandler(common.RefreshStatusURL, "GET", s.RefreshStatus)

	createAccountURL := net.JoinURL(s.casService, casCommon.CreateAccountURL)
	createAccountRoute := engine.CreateProxyRoute(common.CreateAccountURL, "POST", createAccountURL, true)
	s.casRouteRegistry.AddRoute(createAccountRoute, s)

	changePasswordURL := net.JoinURL(s.casService, casCommon.ChangePasswordURL)
	changePasswordRoute := engine.CreateProxyRoute(common.UpdateAccountPasswordURL, "PUT", changePasswordURL, true)
	s.casRouteRegistry.AddRoute(changePasswordRoute, s)

	// update account,query account,delete account
	//---------------------------------------------------------------------------------------
	s.privateRouteRegistry.AddHandler(common.QueryAllAccountURL, "GET", casModel.ReadPrivate, s.QueryAllAccount)
	s.privateRouteRegistry.AddHandler(common.QueryAccountURL, "GET", casModel.ReadPrivate, s.QueryAccount)
	s.privateRouteRegistry.AddHandler(common.DeleteAccountURL, "DELETE", casModel.DeletePrivate, s.DeleteAccount)
	s.privateRouteRegistry.AddHandler(common.UpdateAccountURL, "PUT", casModel.WritePrivate, s.UpdateAccount)

	// update endpoint,query endpoint,delete endpoint
	//---------------------------------------------------------------------------------------
	s.privateRouteRegistry.AddHandler(common.QueryAllEndpointURL, "GET", casModel.ReadPrivate, s.QueryAllEndpoint)
	s.privateRouteRegistry.AddHandler(common.QueryEndpointURL, "GET", casModel.ReadPrivate, s.QueryEndpoint)
	s.privateRouteRegistry.AddHandler(common.CreateEndpointURL, "POST", casModel.WritePrivate, s.CreateEndpoint)
	s.privateRouteRegistry.AddHandler(common.DeleteEndpointURL, "DELETE", casModel.DeletePrivate, s.DeleteEndpoint)
	s.privateRouteRegistry.AddHandler(common.UpdateEndpointURL, "PUT", casModel.WritePrivate, s.UpdateEndpoint)

	// private
	//---------------------------------------------------------------------------------------
	s.privateRouteRegistry.AddHandler(common.QueryAllPrivateURL, "GET", casModel.ReadPrivate, s.QueryPrivateGroup)
	s.privateRouteRegistry.AddHandler(common.QueryPrivateURL, "GET", casModel.ReadPrivate, s.QueryPrivateGroupByID)
	s.privateRouteRegistry.AddHandler(common.SavePrivateURL, "POST", casModel.WritePrivate, s.SavePrivateGroup)
	s.privateRouteRegistry.AddHandler(common.DestroyPrivateURL, "GET", casModel.DeletePrivate, s.DestroyPrivateGroup)

	// upload file
	//---------------------------------------------------------------------------------------
	uploadFileURL := net.JoinURL(s.fileService, fileCommon.UploadFileURL)
	uploadFileRoute := engine.CreateProxyRoute(common.UploadFileURL, "POST", uploadFileURL, true)
	router.AddRoute(uploadFileRoute, s)

	viewFileURL := net.JoinURL(s.fileService, fileCommon.DownloadFileURL)
	viewFileRoute := engine.CreateProxyRoute(common.ViewFileURL, "GET", viewFileURL, true)
	router.AddRoute(viewFileRoute, s)
}

func (s *Base) writeLog(res http.ResponseWriter, req *http.Request, memo string) {
	address := net.GetHTTPRemoteAddress(req)
	account := ""
	curEntity, curErr := s.getCurrentEntity(res, req)
	if curErr == nil {
		account = curEntity.String()
	}

	_, logErr := s.commonHandler.WriteOpLog(account, address, memo)
	if logErr != nil {
		log.Printf("WriteOpLog failed, err:%s", logErr.Error())
	}
}

func (s *Base) getCurrentEntity(res http.ResponseWriter, req *http.Request) (ret *casModel.Entity, err error) {
	curSession := s.sessionRegistry.GetSession(res, req)
	authVal, ok := curSession.GetOption(commonCommon.AuthAccount)
	if !ok {
		err = fmt.Errorf("无效权限,未通过验证")
		return
	}
	ret = authVal.(*casModel.Entity)

	ctx := casCommon.NewEntityContext(nil)
	ctx.Decode(req)

	ctxEntity := ctx.GetEntity()
	if ctxEntity == nil {
		return
	}

	ret = ctxEntity
	return
}
