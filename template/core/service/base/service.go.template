// Base BaseService
type Base struct {
	casService  string
	fileService string

	sessionRegistry      commonSession.Registry
	privateRouteRegistry casToolkit.PrivateRegistry
	casRouteRegistry     casToolkit.CasRegistry

	commonHandler handler.CommonHandler
	casBiz        *biz.Cas
}

// New create base
func New(commonHandler handler.CommonHandler, casService, fileService string) *Base {
	ptr := &Base{
		commonHandler: commonHandler,
		casService:    casService,
		fileService:   fileService,
		casBiz:        biz.NewCas(casService),
	}

	return ptr
}

func (s *Base) BindRegistry(
	sessionRegistry commonSession.Registry,
	casRouteRegistry casToolkit.CasRegistry,
	privateRouteRegistry casToolkit.PrivateRegistry) {

	s.sessionRegistry = sessionRegistry
	s.casRouteRegistry = casRouteRegistry
	s.privateRouteRegistry = privateRouteRegistry
}

// Login login account
func (s *Base) Login(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	result := &casCommon.LoginResult{}
	for {
		param := &casCommon.LoginParam{}
		err := net.ParseJSONBody(req, param)
		if err != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		if param.Account == "" || param.Password == "" {
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数,输入参数为空"
			break
		}

		loginEntity, loginSession, loginErr := s.casBiz.Login(curSession, param.Account, param.Password)
		if loginErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = loginErr.Error()
			break
		}

		curSession.SetSessionInfo(loginSession)
		curSession.SetOption(commonCommon.AuthAccount, loginEntity)
		curSession.Flush(res, req)

		result.Entity = loginEntity
		result.SessionInfo = loginSession
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// Logout logout account
func (s *Base) Logout(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	result := &casCommon.LogoutResult{}
	for {
		logoutSession, logoutErr := s.casBiz.Logout(curSession)
		if logoutErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = logoutErr.Error()
			break
		}

		curSession.SetSessionInfo(logoutSession)
		curSession.RemoveOption(commonCommon.AuthAccount)
		curSession.Flush(res, req)

		result.SessionInfo = logoutSession
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

// ConfirmEndpoint verify endpoint
func (s *Base) ConfirmEndpoint(res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	result := &casCommon.ConfirmResult{}
	for {
		authToken := req.URL.Query().Get("authToken")
		identifyID := req.URL.Query().Get("identifyID")
		if authToken == "" || identifyID == "" {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "无效参数"
			break
		}

		confirmEntity, confirmSession, confirmErr := s.casBiz.ConfirmEndpoint(curSession, identifyID, authToken)
		if confirmErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = confirmErr.Error()
			break
		}

		curSession.SetSessionInfo(confirmSession)
		curSession.SetOption(commonCommon.AuthAccount, confirmEntity)
		curSession.Flush(res, req)

		result.Entity = confirmEntity
		result.SessionInfo = confirmSession
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
	return
}

