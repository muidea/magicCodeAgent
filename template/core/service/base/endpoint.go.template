package base

import (
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"strconv"

	"github.com/muidea/magicCommon/foundation/net"

	casModel "github.com/muidea/magicCas/model"
	commonDef "github.com/muidea/magicCommon/def"
)

// QueryAllEndpoint query member
func (s *Base) QueryAllEndpoint(res http.ResponseWriter, req *http.Request) {
	type queryResult struct {
		commonDef.Result
		Total     int64                    `json:"total"`
		Endpoints []*casModel.EndpointView `json:"endpoints"`
	}

	result := &queryResult{Endpoints: []*casModel.EndpointView{}}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		endpointList, endpointTotal, endpointErr := s.casBiz.QueryAllEndpoint(curSession)
		if endpointErr != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = endpointErr.Error()
			break
		}

		result.Total = endpointTotal
		result.Endpoints = endpointList
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// CreateEndpoint create endpoint
func (s *Base) CreateEndpoint(res http.ResponseWriter, req *http.Request) {
	param := &casModel.EndpointView{}
	result := &commonDef.Result{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		err := net.ParseJSONBody(req, param)
		if err != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "参数非法"
			break
		}
		_, err = s.casBiz.CreateEndpoint(curSession, param)
		if err != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = "新建出错,新建终端信息失败"
			break
		}

		result.ErrorCode = commonDef.Success

		memo := fmt.Sprintf("新建终端%s", param.Endpoint)
		s.writeLog(res, req, memo)
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// DeleteEndpoint delete endpoint
func (s *Base) DeleteEndpoint(res http.ResponseWriter, req *http.Request) {
	result := &commonDef.Result{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		_, value := net.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			log.Printf("delete endpoint failed, illegal id, id:%s, err:%s", value, err.Error())
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		endpointPtr, endpointErr := s.casBiz.DeleteEndpoint(curSession, id)
		if endpointErr != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = endpointErr.Error()
			break
		}

		result.ErrorCode = commonDef.Success

		memo := fmt.Sprintf("删除账号%s", endpointPtr.Endpoint)
		s.writeLog(res, req, memo)
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// QueryEndpoint query endpoint
func (s *Base) QueryEndpoint(res http.ResponseWriter, req *http.Request) {
	type queryResult struct {
		commonDef.Result
		Endpoint *casModel.EndpointView `json:"endpoint"`
	}

	result := &queryResult{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		_, value := net.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			log.Printf("update endpoint failed, illegal id, id:%s, err:%s", value, err.Error())
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		endpointView, endpointErr := s.casBiz.QueryEndpoint(curSession, id)
		if endpointErr != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "参数非法"
		}

		result.Endpoint = endpointView
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// UpdateEndpoint update endpoint
func (s *Base) UpdateEndpoint(res http.ResponseWriter, req *http.Request) {
	param := map[string]int{}
	result := &commonDef.Result{}
	curSession := s.sessionRegistry.GetSession(res, req)
	for {
		_, value := net.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			log.Printf("update endpoint failed, illegal id, id:%s, err:%s", value, err.Error())
			result.ErrorCode = commonDef.Failed
			result.Reason = "非法参数"
			break
		}

		endpointView, endpointErr := s.casBiz.QueryEndpoint(curSession, id)
		if endpointErr != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "参数非法"
			break
		}

		err = net.ParseJSONBody(req, &param)
		if err != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "参数非法"
			break
		}
		status, ok := param["status"]
		if ok {
			endpointView.Status = casModel.GetStatus(status)
		}
		privateGroup, ok := param["privateGroup"]
		if ok {
			endpointView.PrivateGroup = &casModel.PrivateGroupLite{ID: privateGroup}
		}

		_, err = s.casBiz.UpdateEndpoint(curSession, endpointView)
		if err != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = "更新信息出错,更新账号信息失败"
			break
		}

		result.ErrorCode = commonDef.Success

		memo := fmt.Sprintf("更新账号%s", endpointView.Endpoint)
		s.writeLog(res, req, memo)
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}
