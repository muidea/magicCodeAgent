package biz

import (
	"fmt"
	casClient "github.com/muidea/magicCas/client"
	casModel "github.com/muidea/magicCas/model"
	commonCommon "github.com/muidea/magicCommon/common"
	commonSession "github.com/muidea/magicCommon/session"
	"log"
)

type Cas struct {
	casService string
}

func NewCas(casService string) *Cas {
	return &Cas{casService: casService}
}

func (s *Cas) Login(curSession commonSession.Session, account, password, namespace string) (entityPtr *casModel.Entity, sessionInfo *commonCommon.SessionInfo, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	ctxInfo := curSession.GetSessionInfo()
	clnt.BindSession(ctxInfo)
	clnt.AttachNameSpace(namespace)

	loginEntity, loginSession, loginErr := clnt.LoginAccount(account, password)
	if loginErr != nil {
		err = loginErr
		log.Printf("login account failed, err:%s", err.Error())
		return
	}

	entityPtr = loginEntity
	sessionInfo = loginSession
	return
}

func (s *Cas) Logout(curSession commonSession.Session, namespace string) (sessionInfo *commonCommon.SessionInfo, err error) {
	sessionInfo = curSession.GetSessionInfo()
	if sessionInfo == nil {
		err = fmt.Errorf("must login first")
		return
	}

	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	clnt.BindSession(sessionInfo)
	clnt.AttachNameSpace(namespace)

	logoutSession, logoutErr := clnt.LogoutAccount()
	if logoutErr != nil {
		err = logoutErr
		log.Printf("logout account failed, err:%s", err.Error())
		return
	}

	sessionInfo = logoutSession

	return
}

