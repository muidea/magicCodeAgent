func (s *Cas) VerifyPrivate(curSession commonSession.Session, namespace string) (ret *casModel.PrivateGroupLite, err error) {
	sessionInfo := curSession.GetSessionInfo()

	authPtr, authOK := curSession.GetOption(commonCommon.AuthAccount)
	if !authOK {
		err = fmt.Errorf("illegal authority")
		return
	}
	entityPtr := authPtr.(*casModel.Entity)

	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	clnt.BindSession(sessionInfo)
	clnt.AttachNameSpace(namespace)

	privatePtr, verifyErr := clnt.VerifyPrivate(entityPtr)
	if verifyErr != nil {
		err = verifyErr
		log.Printf("verify privateGroup failed, err:%s", verifyErr.Error())
		return
	}

	ret = privatePtr
	return
}

