func GetEntityID(url string) (ret int, err error) {
	id := regexp.MustCompile("[{0-9}]+$").FindString(url)
	if id == "" {
		err = fmt.Errorf("illegal event url, url:%s", url)
		return
	}

	ret, err = strconv.Atoi(id)
	return
}
