package config

import "flag"

var casService = "http://127.0.0.1:8081"
var fileService = "http://127.0.0.1:8083"
var namespace = "local"

func init() {
	flag.StringVar(&casService, "CasService", casService, "magicCas partner address")
	flag.StringVar(&fileService, "FileService", fileService, "magicFile partner address")
	flag.StringVar(&namespace, "Namespace", namespace, "{{.ProjectName}} namespace.")
}

//CasService cas partner addr
func CasService() string {
	return casService
}

//FileService file partner addr
func FileService() string {
	return fileService
}

//Namespace namespace
func Namespace() string {
	return namespace
}
