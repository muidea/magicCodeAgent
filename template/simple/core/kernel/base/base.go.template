package base

import (
	"github.com/muidea/magicBatis/client"
	"github.com/muidea/magicCas/toolkit"
	"github.com/muidea/magicCommon/event"
	"github.com/muidea/magicCommon/session"
	"github.com/muidea/magicCommon/task"
	engine "github.com/muidea/magicEngine"

	"github.com/muidea/{{.ProjectName}}/common"
	"github.com/muidea/{{.ProjectName}}/config"
	"github.com/muidea/{{.ProjectName}}/core/kernel/base/biz"
	"github.com/muidea/{{.ProjectName}}/core/kernel/base/service"
	"github.com/muidea/{{.ProjectName}}/module"
)

func init() {
	module.Register(New())
}

type Base struct {
	batisClient       client.Client
	sessionRegistry   session.Registry
	roleRouteRegistry toolkit.RoleRegistry
	casRouteRegistry  toolkit.CasRegistry
	eventHub          event.Hub
	backgroundRoutine *task.BackgroundRoutine

	service *service.Base
	biz     *biz.Base
}

func New() module.Module {
	return &Base{}
}

func (s *Base) ID() string {
	return common.BaseModule
}

func (s *Base) BindBatisClient(clnt client.Client) {
	s.batisClient = clnt
}

func (s *Base) BindEventHub(eventHub event.Hub) {
	s.eventHub = eventHub
}

func (s *Base) BindBackgroundRoutine(backgroundRoutine *task.BackgroundRoutine) {
	s.backgroundRoutine = backgroundRoutine
}

func (s *Base) BindRegistry(
	sessionRegistry session.Registry,
	casRouteRegistry toolkit.CasRegistry,
	roleRouteRegistry toolkit.RoleRegistry) {

	s.sessionRegistry = sessionRegistry
	s.casRouteRegistry = casRouteRegistry
	s.roleRouteRegistry = roleRouteRegistry
}

func (s *Base) Startup(endpointName string, router engine.Router) {
	s.biz = biz.New(config.CasService(), s.batisClient, s.eventHub, s.backgroundRoutine)

	s.service = service.New(endpointName, config.FileService(), s.biz)
	s.service.BindRegistry(s.sessionRegistry, s.casRouteRegistry, s.roleRouteRegistry)
	s.service.RegisterRoute(router)
}

func (s *Base) Shutdown() {

}
