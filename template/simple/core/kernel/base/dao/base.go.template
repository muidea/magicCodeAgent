package dao

import (
	"github.com/muidea/magicBatis/client"
	"github.com/muidea/magicBatis/def"

	fu "github.com/muidea/magicCommon/foundation/util"

	"github.com/muidea/{{.ProjectName}}/model"
)

type Base interface {
	QueryLog(filter *def.QueryFilter) (ret []*model.Log, total int64, err error)
	WriteLog(log *model.Log) (ret *model.Log, err error)
}

// New 新建Base
func New(clnt client.Client) Base {
	return &base{batisClient: clnt}
}

type base struct {
	batisClient client.Client
}

func (s *base) QueryLog(filter *def.QueryFilter) (ret []*model.Log, total int64, err error) {
	ret = []*model.Log{}
	if filter == nil {
		filter = def.NewFilter()
	}
	filter.SortFilter = &fu.SortFilter{AscSort: false, FieldName: "CreateTime"}

	total, err = s.batisClient.BatchQueryEntity(&ret, filter)
	return
}

func (s *base) WriteLog(log *model.Log) (ret *model.Log, err error) {
	err = s.batisClient.InsertEntity(log)
	if err == nil {
		ret = log
	}
	return
}
