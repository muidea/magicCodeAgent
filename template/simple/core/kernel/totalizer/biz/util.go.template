}
func (s *Totalizer) onDecreaseTotalizer(owner string) {
	s.Invoke(func() {
		//ntv := Type2Totalizer{}
		for _, tv := range s.type2Totalizer {
			//nnv := Owner2Totalizer{}
			for k, v := range tv {
				if k != owner {
					//nnv[k] = v
