package biz

import (
	commonDef "github.com/muidea/magicCommon/def"

	casClient "github.com/muidea/magicCas/client"
	casCommon "github.com/muidea/magicCas/common"
	casModel "github.com/muidea/magicCas/model"

	"github.com/muidea/{{.ProjectName}}/common"
	"github.com/muidea/{{.ProjectName}}/config"
)

func (s *Authority) FilterAuthorityRole(filter *commonDef.Filter) (ret []*casModel.Role, total int64, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	ret, total, err = clnt.FilterRole(filter)
	return
}

func (s *Authority) QueryAuthorityRole(id int) (ret *casModel.Role, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	ret, err = clnt.QueryRole(id)
	return
}

func (s *Authority) CreateAuthorityRole(ptr *common.RoleParam) (ret *casModel.Role, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	param := &casCommon.RoleParam{Name: ptr.Name, Description: ptr.Description, Private: ptr.Private, Namespace: config.Namespace()}
	ret, err = clnt.CreateRole(param)
	return
}

func (s *Authority) UpdateAuthorityRole(ptr *common.Role) (ret *casModel.Role, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	role := ptr.ToRole()
	role.Namespace = config.Namespace()
	ret, err = clnt.UpdateRole(role)
	return
}

func (s *Authority) DeleteAuthorityRole(id int) (ret *casModel.Role, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	ret, err = clnt.DeleteRole(id)
	return
}
