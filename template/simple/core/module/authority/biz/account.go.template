package biz

import (
	commonDef "github.com/muidea/magicCommon/def"
	"github.com/muidea/{{.ProjectName}}/config"

	casClient "github.com/muidea/magicCas/client"
	casCommon "github.com/muidea/magicCas/common"
	casModel "github.com/muidea/magicCas/model"

	"github.com/muidea/{{.ProjectName}}/common"
)

func (s *Authority) FilterAuthorityAccount(filter *commonDef.Filter) (ret []*casModel.Account, total int64, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	ret, total, err = clnt.FilterAccount(filter)
	return
}

func (s *Authority) QueryAuthorityAccount(id int) (ret *casModel.Account, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	ret, err = clnt.QueryAccount(id)
	return
}

func (s *Authority) CreateAuthorityAccount(ptr *common.AccountParam) (ret *casModel.Account, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	param := &casCommon.AccountParam{Account: ptr.Account, Password: ptr.Password, EMail: ptr.EMail, Description: ptr.Description, Namespace: config.Namespace()}
	ret, err = clnt.CreateAccount(param)
	return
}

func (s *Authority) UpdateAuthorityAccount(ptr *common.Account) (ret *casModel.Account, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	account := ptr.ToAccount()
	account.Namespace = config.Namespace()
	ret, err = clnt.UpdateAccount(account)
	return
}

func (s *Authority) DeleteAuthorityAccount(id int) (ret *casModel.Account, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(config.Namespace())

	ret, err = clnt.DeleteAccount(id)
	return
}
