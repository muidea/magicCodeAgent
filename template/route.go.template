package route

import (
	"fmt"
	"log"
	"net/http"

	commonCommon "github.com/muidea/magicCommon/common"
	"github.com/muidea/magicCommon/foundation/net"

	"github.com/muidea/magicCommon/session"

	"github.com/muidea/%projectName%/config"
	"github.com/muidea/%projectName%/core/handler"

	casClient "github.com/muidea/magicCas/client"
	casModel "github.com/muidea/magicCas/model"
	casEndpoint "github.com/muidea/magicCas/toolkit/endpoint"
	casPrivate "github.com/muidea/magicCas/toolkit/private"
	engine "github.com/muidea/magicEngine"
	userClient "github.com/muidea/magicUser/client"
	userModel "github.com/muidea/magicUser/model"
)

const _podName = "appPod"

// Registry 路由信息
type Registry struct {
	commonHandler        handler.CommonHandler
	sessionRegistry      session.Registry
	privatePod           *casModel.PodLite
	privateRouteRegistry casPrivate.RouteRegistry

	userService string
	casService  string
	fileService string
}

// NewRoute create route
func NewRoute(
	sessionRegistry session.Registry,
	commonHandler handler.CommonHandler,
) *Registry {
	casEndpoint := casEndpoint.NewEndpoint(config.EndpointName(), config.IdentifyID(), config.AuthToken(), config.CasService())
	podPtr, podErr := casEndpoint.QueryPod()
	if podErr != nil {
		return nil
	}

	route := &Registry{
		sessionRegistry:      sessionRegistry,
		commonHandler:        commonHandler,
		privatePod:           podPtr,
		privateRouteRegistry: casPrivate.NewRouteRegistry(sessionRegistry),
		casService:           config.CasService(),
		userService:          config.UserService(),
		fileService:          config.FileService(),
	}

	return route
}

func (s *Registry) updateSessionAccount(sessionInfo *commonCommon.SessionInfo, session session.Session) {
	casClient := casClient.NewClient(s.casService)
	defer casClient.Release()
	casClient.BindSession(sessionInfo)

	var err error
	defer func() {
		if err != nil {
			s.clearSessionAccount(sessionInfo, session)
		}
	}()

	accountPtr, accountSession, accountErr := casClient.StatusAccount()
	if accountErr != nil {
		err = accountErr
		log.Printf("get account status failed, err:%s", accountErr.Error())
		return
	}

	session.SetOption(commonCommon.AuthAccount, accountPtr)
	session.SetOption(commonCommon.SessionIdentity, accountSession)
}

func (s *Registry) clearSessionAccount(sessionInfo *commonCommon.SessionInfo, session session.Session) {
	session.RemoveOption(commonCommon.AuthAccount)
	session.RemoveOption(commonCommon.SessionIdentity)
}

func (s *Registry) writeCreateUserRecord(res http.ResponseWriter, req *http.Request) {
	account := &casModel.AccountLite{}
	err := net.ParseJSONBody(req, account)
	if err != nil {
		return
	}

	memo := fmt.Sprintf("新建账号%s", account.Account)
	s.writelog(res, req, memo)
}

func (s *Registry) writeUpdateUserPasswordRecord(res http.ResponseWriter, req *http.Request) {
	account := &casModel.AccountLite{}
	err := net.ParseJSONBody(req, account)
	if err != nil {
		return
	}

	memo := fmt.Sprintf("修改账号%s密码", account.Account)
	s.writelog(res, req, memo)
}

// Handle middleware handler
func (s *Registry) Handle(ctx engine.RequestContext, res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	sessionInfo := &commonCommon.SessionInfo{}
	sessionInfo.Decode(req)
	sessionInfo.ID = curSession.ID()
	sessionInfo.Scope = commonCommon.ShareSession

	values := req.URL.Query()
	sessionInfo.Merge(values)
	req.URL.RawQuery = values.Encode()

	//将当前的pod设置到当前session
	curSession.SetOption(casPrivate.CurrentPrivatePod, s.privatePod)

	ctx.Next()

	switch req.URL.Path {
	case "/user/login/":
	case "/user/status/":
		s.updateSessionAccount(sessionInfo, curSession)
	case "/user/logout/":
		s.clearSessionAccount(sessionInfo, curSession)
	case "/user/create/":
		s.writeCreateUserRecord(res, req)
	case "/user/change/password/":
		s.writeUpdateUserPasswordRecord(res, req)
	}
}

// RegisterRoute 注册路由
func (s *Registry) RegisterRoute(router engine.Router) {
	// account login,logout,status,changepassword
	//---------------------------------------------------------------------------------------
	statusURL := net.JoinURL(s.casService, "/access/status/")
	statusRoute := engine.CreateProxyRoute("/user/status/", "GET", statusURL, true)
	router.AddRoute(statusRoute, s)

	loginURL := net.JoinURL(s.casService, "/access/login/")
	loginRoute := engine.CreateProxyRoute("/user/login/", "POST", loginURL, true)
	router.AddRoute(loginRoute, s)

	logoutURL := net.JoinURL(s.casService, "/access/logout/")
	logoutRoute := engine.CreateProxyRoute("/user/logout/", "DELETE", logoutURL, true)
	router.AddRoute(logoutRoute, s)

	createAccountURL := net.JoinURL(s.casService, "/account/create/")
	createAccountRoute := engine.CreateProxyRoute("/user/create/", "POST", createAccountURL, true)
	router.AddRoute(createAccountRoute, s)

	changePasswordURL := net.JoinURL(s.casService, "/account/password/")
	changePasswordRoute := engine.CreateProxyRoute("/user/change/password/", "PUT", changePasswordURL, true)
	router.AddRoute(changePasswordRoute, s)

	// update user,query user,delete user
	//---------------------------------------------------------------------------------------
	s.privateRouteRegistry.AddHandler("/user/query/all/", "GET", casModel.ReadPrivate, s.QueryAllAccount)
	s.privateRouteRegistry.AddHandler("/user/delete/:id", "DELETE", casModel.DeletePrivate, s.DeleteAccount)
	s.privateRouteRegistry.AddHandler("/user/update/status/", "GET", casModel.WritePrivate, s.UpdateStatusAccount)

	// upload file
	//---------------------------------------------------------------------------------------
	uploadFileURL := net.JoinURL(s.fileService, "/file/upload/")
	uploadFileRoute := engine.CreateProxyRoute("/file/upload/", "POST", uploadFileURL, true)
	router.AddRoute(uploadFileRoute, s)

	viewFileURL := net.JoinURL(s.fileService, "/file/download/")
	viewFileRoute := engine.CreateProxyRoute("/file/view/", "GET", viewFileURL, true)
	router.AddRoute(viewFileRoute, s)

	s.privateRouteRegistry.RegisterRoute(router)
}

func (s *Registry) writelog(res http.ResponseWriter, req *http.Request, memo string) {
	address := net.GetHTTPRemoteAddress(req)
	account := ""
	curSession := s.sessionRegistry.GetSession(res, req)
	authVal, ok := curSession.GetOption(commonCommon.AuthAccount)
	if ok {
		for {
			accountLite, accountOK := authVal.(*casModel.AccountLite)
			if accountOK {
				account = accountLite.Account
				break
			}

			endpointLite, endpointOK := authVal.(*casModel.EndpointLite)
			if endpointOK {
				account = endpointLite.Endpoint
				break
			}

			break
		}
	}

	_, logErr := s.commonHandler.WriteOpLog(account, address, memo)
	if logErr != nil {
		log.Printf("WriteOpLog failed, err:%s", logErr.Error())
	}
}
