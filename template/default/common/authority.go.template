package common

import (
	casCommon "github.com/muidea/magicCas/common"
	commonDef "github.com/muidea/magicCommon/def"
)

const (
	FilterAuthorityAccountURL = "/api/v1/authority/account/query/"
	QueryAuthorityAccountURL  = "/api/v1/authority/account/query/:id"
	CreateAuthorityAccountURL = "/api/v1/authority/account/create/"
	UpdateAuthorityAccountURL = "/api/v1/authority/account/update/:id"
	DeleteAuthorityAccountURL = "/api/v1/authority/account/delete/:id"

	FilterAuthorityEndpointURL = "/api/v1/authority/endpoint/query/"
	QueryAuthorityEndpointURL  = "/api/v1/authority/endpoint/query/:id"
	CreateAuthorityEndpointURL = "/api/v1/authority/endpoint/create/"
	UpdateAuthorityEndpointURL = "/api/v1/authority/endpoint/update/:id"
	DeleteAuthorityEndpointURL = "/api/v1/authority/endpoint/delete/:id"

	FilterAuthorityRoleURL = "/api/v1/authority/role/query/"
	QueryAuthorityRoleURL  = "/api/v1/authority/role/query/:id"
	CreateAuthorityRoleURL = "/api/v1/authority/role/create/"
	UpdateAuthorityRoleURL = "/api/v1/authority/role/update/:id"
	DeleteAuthorityRoleURL = "/api/v1/authority/role/delete/:id"

	FilterAuthorityNamespaceURL = "/api/v1/authority/namespace/query/"
	QueryAuthorityNamespaceURL  = "/api/v1/authority/namespace/query/:id"
	CreateAuthorityNamespaceURL = "/api/v1/authority/namespace/create/"
	UpdateAuthorityNamespaceURL = "/api/v1/authority/namespace/update/:id"
	DeleteAuthorityNamespaceURL = "/api/v1/authority/namespace/delete/:id"
)

type AccountParam struct {
	Account     string `json:"account" validate:"required"`
	Password    string `json:"password" validate:"required"`
	EMail       string `json:"email"`
	Description string `json:"description"`
}

type Account struct {
	casCommon.AccountView
}

type AccountResult struct {
	commonDef.Result
	Account *casCommon.AccountView `json:"account"`
}

type AccountListResult casCommon.AccountListResult

type AccountStatisticResult struct {
	commonDef.Result
	Total   int64                    `json:"total"`
	Account []*casCommon.AccountView `json:"account"`
	Role    []*casCommon.RoleLite    `json:"role"`
}

type EndpointParam struct {
	Endpoint    string `json:"endpoint" validate:"required"`
	Description string `json:"description"`
	IdentifyID  string `json:"identifyID" validate:"required"`
	AuthToken   string `json:"authToken" validate:"required"`
	Status      int    `json:"status"`
}

type Endpoint struct {
	casCommon.EndpointView
}

type EndpointResult struct {
	commonDef.Result
	Endpoint *casCommon.EndpointView `json:"endpoint"`
}

type EndpointListResult casCommon.EndpointListResult

type EndpointStatisticResult struct {
	commonDef.Result
	Total    int64                     `json:"total"`
	Endpoint []*casCommon.EndpointView `json:"endpoint"`
	Role     []*casCommon.RoleLite     `json:"role"`
}

type RoleParam struct {
	Name        string                   `json:"name" validate:"required"`
	Description string                   `json:"description"`
	Private     []*casCommon.PrivateItem `json:"private"`
}

type Role struct {
	casCommon.RoleView
}

type RoleResult struct {
	commonDef.Result
	Role *casCommon.RoleView `json:"role"`
}

type RoleListResult casCommon.RoleListResult

type RoleStatisticResult struct {
	commonDef.Result
	Total int64                 `json:"total"`
	Role  []*casCommon.RoleView `json:"role"`
}

type NamespaceParam struct {
	casCommon.NamespaceParam
}

type Namespace struct {
	casCommon.NamespaceView
}

type NamespaceResult struct {
	commonDef.Result
	Namespace *casCommon.NamespaceView `json:"namespace"`
}

type NamespaceListResult casCommon.NamespaceListResult

type NamespaceStatisticResult struct {
	commonDef.Result
	Total     int64                      `json:"total"`
	Namespace []*casCommon.NamespaceView `json:"namespace"`
}
