package biz

import (
	commonDef "github.com/muidea/magicCommon/def"

	casClient "github.com/muidea/magicCas/client"
	casCommon "github.com/muidea/magicCas/common"
	casModel "github.com/muidea/magicCas/model"

	"github.com/muidea/{{.ProjectName}}/common"
)

func (s *Authority) FilterAuthorityAccount(filter *commonDef.Filter, namespace string) (ret []*casModel.Account, total int64, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, total, err = clnt.FilterAccount(filter)
	return
}

func (s *Authority) QueryAuthorityAccount(id int, namespace string) (ret *casModel.Account, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.QueryAccount(id)
	return
}

func (s *Authority) CreateAuthorityAccount(ptr *common.AccountParam, namespace string) (ret *casModel.Account, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	param := &casCommon.AccountParam{Account: ptr.Account, Password: ptr.Password, EMail: ptr.EMail, Description: ptr.Description, Namespace: namespace}
	ret, err = clnt.CreateAccount(param)
	return
}

func (s *Authority) UpdateAuthorityAccount(ptr *common.Account, namespace string) (ret *casModel.Account, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	account := ptr.ToAccount()
	account.Namespace = namespace
	ret, err = clnt.UpdateAccount(account)
	return
}

func (s *Authority) DeleteAuthorityAccount(id int, namespace string) (ret *casModel.Account, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.DeleteAccount(id)
	return
}
