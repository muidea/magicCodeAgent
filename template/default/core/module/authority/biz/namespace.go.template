package biz

import (
	commonDef "github.com/muidea/magicCommon/def"

	casClient "github.com/muidea/magicCas/client"
	casModel "github.com/muidea/magicCas/model"

	"github.com/muidea/{{.ProjectName}}/common"
)

func (s *Authority) FilterAuthorityNamespace(filter *commonDef.Filter, namespace string) (ret []*casModel.Namespace, total int64, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, total, err = clnt.FilterNamespace(filter)
	return
}

func (s *Authority) QueryAuthorityNamespace(id int, namespace string) (ret *casModel.Namespace, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.QueryNamespace(id)
	return
}

func (s *Authority) CreateAuthorityNamespace(ptr *common.NamespaceParam, namespace string) (ret *casModel.Namespace, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.CreateNamespace(&ptr.NamespaceParam)
	return
}

func (s *Authority) UpdateAuthorityNamespace(id int, ptr *common.NamespaceParam, namespace string) (ret *casModel.Namespace, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.UpdateNamespace(id, &ptr.NamespaceParam)
	return
}

func (s *Authority) DeleteAuthorityNamespace(id int, namespace string) (ret *casModel.Namespace, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.DeleteNamespace(id)
	return
}
