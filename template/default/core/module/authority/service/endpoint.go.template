package service

import (
	"encoding/json"
	"fmt"
	"net/http"
	"strconv"

	log "github.com/cihub/seelog"

	casCommon "github.com/muidea/magicCas/common"
	commonDef "github.com/muidea/magicCommon/def"
	fn "github.com/muidea/magicCommon/foundation/net"

	"github.com/muidea/{{.ProjectName}}/common"
)

func (s *Authority) filterAuthorityEndpointLite(res http.ResponseWriter, req *http.Request, filter *commonDef.Filter) {
	result := &common.EndpointListResult{Endpoint: []*casCommon.EndpointLite{}}
	for {
		curNamespace := s.getCurrentNamespace(res, req)
		endpointList, _, endpointErr := s.bizPtr.FilterAuthorityEndpoint(filter, curNamespace)
		if endpointErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = endpointErr.Error()
			break
		}

		for _, val := range endpointList {
			endpointLite := &casCommon.EndpointLite{}
			endpointLite.FromEndpoint(val)
			result.Endpoint = append(result.Endpoint, endpointLite)
		}

		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) FilterAuthorityEndpoint(res http.ResponseWriter, req *http.Request) {
	filter := commonDef.NewFilter()
	filter.Decode(req)

	modelVal, modelOK := filter.Get("mode")
	if modelOK && modelVal == "1" {
		s.filterAuthorityEndpointLite(res, req, filter)
		return
	}

	result := &common.EndpointStatisticResult{Endpoint: []*casCommon.EndpointView{}, Role: []*casCommon.RoleLite{}}
	for {
		curNamespace := s.getCurrentNamespace(res, req)
		endpointList, endpointTotal, endpointErr := s.bizPtr.FilterAuthorityEndpoint(filter, curNamespace)
		if endpointErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = endpointErr.Error()
			break
		}
		for _, val := range endpointList {
			view := &casCommon.EndpointView{}
			view.FromEndpoint(val)
			result.Endpoint = append(result.Endpoint, view)
		}

		roleList, _, roleErr := s.bizPtr.FilterAuthorityRole(nil, curNamespace)
		if roleErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = roleErr.Error()
			break
		}
		for _, val := range roleList {
			lite := &casCommon.RoleLite{}
			lite.FromRole(val)
			result.Role = append(result.Role, lite)
		}

		result.Total = endpointTotal
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) QueryAuthorityEndpoint(res http.ResponseWriter, req *http.Request) {
	result := &common.EndpointResult{}
	for {
		_, value := fn.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			result.ErrorCode = commonDef.Failed
			result.Reason = "invalid param"
			break
		}

		curNamespace := s.getCurrentNamespace(res, req)
		endpointPtr, endpointErr := s.bizPtr.QueryAuthorityEndpoint(id, curNamespace)
		if endpointErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = endpointErr.Error()
			break
		}

		result.Endpoint = &casCommon.EndpointView{}
		result.Endpoint.FromEndpoint(endpointPtr)
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) CreateAuthorityEndpoint(res http.ResponseWriter, req *http.Request) {
	result := &common.EndpointResult{}
	for {
		param := &common.EndpointParam{}
		err := fn.ParseJSONBody(req, s.validator, param)
		if err != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "invalid param"
			break
		}

		curNamespace := s.getCurrentNamespace(res, req)
		endpointPtr, endpointErr := s.bizPtr.CreateAuthorityEndpoint(param, curNamespace)
		if endpointErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = endpointErr.Error()
			break
		}

		memo := fmt.Sprintf("新建Endpoint:%s", endpointPtr.Endpoint)
		s.writeLog(res, req, memo)

		result.Endpoint = &casCommon.EndpointView{}
		result.Endpoint.FromEndpoint(endpointPtr)
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) UpdateAuthorityEndpoint(res http.ResponseWriter, req *http.Request) {
	result := &common.EndpointResult{}
	for {
		_, value := fn.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			log.Errorf("update partner failed, illegal id, id:%s", value)
			result.ErrorCode = commonDef.Failed
			result.Reason = "invalid param"
			break
		}

		param := &common.Endpoint{}
		err = fn.ParseJSONBody(req, s.validator, param)
		if err != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "invalid param"
			break
		}
		param.ID = id

		curNamespace := s.getCurrentNamespace(res, req)
		endpointPtr, endpointErr := s.bizPtr.UpdateAuthorityEndpoint(param, curNamespace)
		if endpointErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = endpointErr.Error()
			break
		}

		memo := fmt.Sprintf("更新Endpoint:%s", endpointPtr.Endpoint)
		s.writeLog(res, req, memo)

		result.Endpoint = &casCommon.EndpointView{}
		result.Endpoint.FromEndpoint(endpointPtr)
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

