func (s *Base) EnumPrivate(res http.ResponseWriter, req *http.Request) {
	type enumResult struct {
		commonDef.Result
		Private []*casCommon.PrivateItem `json:"private"`
	}

	namespace := s.getCurrentNamespace(res, req)
	result := &enumResult{Private: []*casCommon.PrivateItem{}}
	for {
		items := s.roleRouteRegistry.GetAllPrivateItem()
		for _, val := range items {
			if s.systemBiz.IsSpecialRoute(val.Path) && !s.isSuperNamespace(namespace) {
				continue
			}
			if !s.systemBiz.IsSettingRoute(val.Path) {
				if !s.systemBiz.IsSpecialRoute(val.Path) && s.isSuperNamespace(namespace) {
					continue
				}
			}

			result.Private = append(result.Private, val)
		}
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusInternalServerError)
}

// GetSystemInfo get system info
func (s *Base) GetSystemInfo(res http.ResponseWriter, req *http.Request) {
	type getResult struct {
		commonDef.Result
		Route   []*biz.Route   `json:"route"`
		Content []*biz.Content `json:"content"`
	}

	result := &getResult{}
	for {
		curSession := s.sessionRegistry.GetSession(res, req)
		curEntity, curErr := s.getCurrentEntity(res, req)
		if curErr != nil {
			result.ErrorCode = commonDef.InvalidAuthority
			result.Reason = "无效权限"
			break
		}

		namespace := s.getCurrentNamespace(res, req)
		curAccount, curErr := s.casBiz.QueryAccount(curSession, curEntity.EID, namespace)
		if curErr != nil {
			result.ErrorCode = commonDef.InvalidAuthority
			result.Reason = "无效权限"
			break
		}

		isSuper := s.isSuperNamespace(namespace)
		result.Route, result.Content = s.systemBiz.SystemInfo(curAccount.Role, isSuper)
		break
	}
	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

// Verify verify current commonSession
func (s *Base) Verify(res http.ResponseWriter, req *http.Request) (err error) {
	curSession := s.sessionRegistry.GetSession(res, req)

	namespace := s.getCurrentNamespace(res, req)
	sessionEntity, sessionInfo, sessionErr := s.casBiz.RefreshSession(curSession, namespace)
	if sessionErr != nil {
		err = sessionErr
		log.Errorf("verify current commonSession failed, err:%s", sessionErr.Error())
		return
	}

	curSession.SetSessionInfo(sessionInfo)
	curSession.SetOption(commonCommon.AuthAccount, sessionEntity)
	curSession.Flush(res, req)

	return
}

// VerifyRole verify role
func (s *Base) VerifyRole(res http.ResponseWriter, req *http.Request) (ret *casModel.Role, err error) {
	curSession := s.sessionRegistry.GetSession(res, req)

	curEntity, curErr := s.getCurrentEntity(res, req)
	if curErr != nil {
		err = curErr
		return
	}

	namespace := s.getCurrentNamespace(res, req)
	_, ret, err = s.casBiz.VerifyEntity(curSession, curEntity, namespace)
	return
}

// Handle middleware handler
func (s *Base) Handle(ctx engine.RequestContext, res http.ResponseWriter, req *http.Request) {
	curSession := s.sessionRegistry.GetSession(res, req)

	sessionInfo := curSession.GetSessionInfo()
	sessionInfo.Scope = commonCommon.ShareSession

	values := req.URL.Query()
	values = sessionInfo.Encode(values)
	req.URL.RawQuery = values.Encode()

	ctx.Next()
}

// RegisterHandler 注册路由
func (s *Base) RegisterHandler(router engine.Router) {
	// account login,logout, confirm, refresh
	//---------------------------------------------------------------------------------------
	loginRoute := engine.CreateRoute(common.LoginAccountURL, "POST", s.Login)
	router.AddRoute(loginRoute, s)

	logoutRoute := engine.CreateRoute(common.LogoutAccountURL, "DELETE", s.Logout)
	s.casRouteRegistry.AddRoute(logoutRoute, s)

	changePasswordRoute := engine.CreateRoute(common.UpdateAccountPasswordURL, "PUT", s.UpdateAccountPassword)
	s.casRouteRegistry.AddRoute(changePasswordRoute, s)

	verifyEndpointRoute := engine.CreateRoute(common.VerifyEndpointURL, "GET", s.VerifyEndpoint)
	router.AddRoute(verifyEndpointRoute, s)

	s.casRouteRegistry.AddHandler(common.RefreshSessionURL, "GET", s.RefreshSession)

	s.casRouteRegistry.AddHandler(common.QueryAccessLogURL, "GET", s.QueryAccessLog)

	s.casRouteRegistry.AddHandler(common.QueryOperateLogURL, "GET", s.QueryOperateLog)

	s.roleRouteRegistry.AddHandler(common.EnumPrivateURL, "GET", casCommon.ReadPrivate, s.EnumPrivate)

	// upload file
	//---------------------------------------------------------------------------------------
	uploadFileURL := fn.JoinURL(s.fileService, fileCommon.UploadFileURL)
	uploadFileRoute := engine.CreateProxyRoute(common.UploadFileURL, "POST", uploadFileURL, true)
	router.AddRoute(uploadFileRoute, s)

	viewFileURL := fn.JoinURL(s.fileService, fileCommon.DownloadFileURL)
	viewFileRoute := engine.CreateProxyRoute(common.ViewFileURL, "GET", viewFileURL, true)
	router.AddRoute(viewFileRoute, s)

	s.casRouteRegistry.AddHandler(common.QuerySystemInfoURL, "GET", s.GetSystemInfo)
}

func (s *Base) writeLog(res http.ResponseWriter, req *http.Request, memo string) {
	address := fn.GetHTTPRemoteAddress(req)
	curEntity, _ := s.getCurrentEntity(res, req)
	curNamespace := s.getCurrentNamespace(res, req)
	_, logErr := s.common.WriteLog(address, memo, curEntity.ID, curNamespace)
	if logErr != nil {
		log.Errorf("Write log failed, err:%s", logErr.Error())
	}
}

func (s *Base) getCurrentEntity(res http.ResponseWriter, req *http.Request) (ret *casModel.Entity, err error) {
	curSession := s.sessionRegistry.GetSession(res, req)
	authVal, ok := curSession.GetOption(commonCommon.AuthAccount)
	if !ok {
		err = fmt.Errorf("无效权限,未通过验证")
		return
	}
	ret = authVal.(*casModel.Entity)

	ctx := casCommon.NewEntityContext(nil)
	ctx.Decode(req)

	ctxEntity := ctx.GetEntity()
	if ctxEntity == nil {
		return
	}

	ret = ctxEntity
	return
}

func (s *Base) queryEntity(id int, sessionInfo *commonCommon.SessionInfo, namespace string) (ret *casModel.Entity) {
	entityPtr, entityErr := s.common.QueryEntity(id, sessionInfo, namespace)
	if entityErr != nil {
		ret = casModel.UnknownEntity()
		return
	}

	ret = entityPtr
	return
}

func (s *Base) getCurrentNamespace(res http.ResponseWriter, req *http.Request) (ret string) {
	namespace := req.Header.Get(casCommon.NamespaceID)
	if namespace != "" {
		ret = namespace
		return
	}

	items := strings.Split(req.Host, ":")
	if nil != net.ParseIP(items[0]) {
		ret = "default"
		return
	}

	items = strings.Split(items[0], ".")
	if len(items) <= 1 {
		ret = "default"
		return
	}

	ret = items[0]
	return
}

func (s *Base) isSuperNamespace(namespace string) bool {
	return namespace == config.SuperNamespace()
}
