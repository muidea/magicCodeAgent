func (s *Authority) filterAuthorityRoleLite(res http.ResponseWriter, req *http.Request, filter *commonDef.Filter) {
	result := &common.RoleListResult{Role: []*casCommon.RoleLite{}}
	for {
		curNamespace := s.getCurrentNamespace(res, req)
		roleList, _, roleErr := s.authorityBiz.FilterAuthorityRole(filter, curNamespace)
		if roleErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = roleErr.Error()
			break
		}

		for _, val := range roleList {
			roleLite := &casCommon.RoleLite{}
			roleLite.FromRole(val)
			result.Role = append(result.Role, roleLite)
		}

		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) FilterAuthorityRole(res http.ResponseWriter, req *http.Request) {
	filter := commonDef.NewFilter()
	filter.Decode(req)

	modelVal, modelOK := filter.Get("mode")
	if modelOK && modelVal == "1" {
		s.filterAuthorityRoleLite(res, req, filter)
		return
	}

	result := &common.RoleStatisticResult{Role: []*casCommon.RoleView{}}
	for {
		curNamespace := s.getCurrentNamespace(res, req)
		roleList, roleTotal, roleErr := s.authorityBiz.FilterAuthorityRole(filter, curNamespace)
		if roleErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = roleErr.Error()
			break
		}

		result.Role = []*casCommon.RoleView{}
		for _, val := range roleList {
			view := &casCommon.RoleView{}
			view.FromRole(val)
			result.Role = append(result.Role, view)
		}

		result.Total = roleTotal
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) QueryAuthorityRole(res http.ResponseWriter, req *http.Request) {
	result := &common.RoleResult{}
	for {
		_, value := fn.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			result.ErrorCode = commonDef.Failed
			result.Reason = "invalid param"
			break
		}

		curNamespace := s.getCurrentNamespace(res, req)
		rolePtr, roleErr := s.authorityBiz.QueryAuthorityRole(id, curNamespace)
		if roleErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = roleErr.Error()
			break
		}

		result.Role = &casCommon.RoleView{}
		result.Role.FromRole(rolePtr)
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) CreateAuthorityRole(res http.ResponseWriter, req *http.Request) {
	result := &common.RoleResult{}
	for {
		param := &casCommon.RoleParam{}
		err := fn.ParseJSONBody(req, s.validator, param)
		if err != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "invalid param"
			break
		}

		curNamespace := s.getCurrentNamespace(res, req)
		rolePtr, roleErr := s.authorityBiz.CreateAuthorityRole(param, curNamespace)
		if roleErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = roleErr.Error()
			break
		}

		memo := fmt.Sprintf("删除Role:%s", rolePtr.Name)
		s.writeLog(res, req, memo)

		result.Role = &casCommon.RoleView{}
		result.Role.FromRole(rolePtr)
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) UpdateAuthorityRole(res http.ResponseWriter, req *http.Request) {
	result := &common.RoleResult{}
	for {
		_, value := fn.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			log.Errorf("update partner failed, illegal id, id:%s", value)
			result.ErrorCode = commonDef.Failed
			result.Reason = "invalid param"
			break
		}

		param := &casModel.Role{}
		err = fn.ParseJSONBody(req, s.validator, param)
		if err != nil {
			result.ErrorCode = commonDef.IllegalParam
			result.Reason = "invalid param"
			break
		}
		param.ID = id

		curNamespace := s.getCurrentNamespace(res, req)
		rolePtr, roleErr := s.authorityBiz.UpdateAuthorityRole(param, curNamespace)
		if roleErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = roleErr.Error()
			break
		}

		memo := fmt.Sprintf("删除Role:%s", rolePtr.Name)
		s.writeLog(res, req, memo)

		result.Role = &casCommon.RoleView{}
		result.Role.FromRole(rolePtr)
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

