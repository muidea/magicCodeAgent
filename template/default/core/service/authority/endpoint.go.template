func (s *Authority) filterAuthorityEndpointLite(res http.ResponseWriter, req *http.Request, filter *commonDef.Filter) {
	result := &casCommon.EndpointListResult{Endpoint: []*casCommon.EndpointLite{}}
	for {
		curNamespace := s.getCurrentNamespace(res, req)
		endpointList, _, endpointErr := s.authorityBiz.FilterAuthorityEndpoint(filter, curNamespace)
		if endpointErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = endpointErr.Error()
			break
		}

		for _, val := range endpointList {
			endpointLite := &casCommon.EndpointLite{}
			endpointLite.FromEndpoint(val)
			result.Endpoint = append(result.Endpoint, endpointLite)
		}

		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) FilterAuthorityEndpoint(res http.ResponseWriter, req *http.Request) {
	filter := commonDef.NewFilter()
	filter.Decode(req)

	modelVal, modelOK := filter.Get("mode")
	if modelOK && modelVal == "1" {
		s.filterAuthorityEndpointLite(res, req, filter)
		return
	}

	result := &casCommon.EndpointStatisticResult{Endpoint: []*casModel.Endpoint{}}
	for {
		curNamespace := s.getCurrentNamespace(res, req)
		endpointList, endpointTotal, endpointErr := s.authorityBiz.FilterAuthorityEndpoint(filter, curNamespace)
		if endpointErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = endpointErr.Error()
			break
		}

		result.Endpoint = endpointList
		result.Total = endpointTotal
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

func (s *Authority) QueryAuthorityEndpoint(res http.ResponseWriter, req *http.Request) {
	result := &casCommon.EndpointResult{}
	for {
		_, value := fn.SplitRESTAPI(req.URL.Path)
		id, err := strconv.Atoi(value)
		if err != nil || id == 0 {
			result.ErrorCode = commonDef.Failed
			result.Reason = "invalid param"
			break
		}

		curNamespace := s.getCurrentNamespace(res, req)
		endpointPtr, endpointErr := s.authorityBiz.QueryAuthorityEndpoint(id, curNamespace)
		if endpointErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = endpointErr.Error()
			break
		}

		result.Endpoint = endpointPtr
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}

