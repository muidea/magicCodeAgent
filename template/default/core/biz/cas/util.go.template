package cas

import (
	log "github.com/cihub/seelog"
	casCommon "github.com/muidea/magicCas/common"
	casModel "github.com/muidea/magicCas/model"
	commonSession "github.com/muidea/magicCommon/session"
)

func (s *Cas) createDefaultAccount(session commonSession.Session, namespace string) {
	defaultAccount := casModel.DefaultSuperAccount()
	ptr := &casCommon.AccountParam{Account: defaultAccount.Account, Password: defaultAccount.Password, EMail: defaultAccount.EMail, Description: defaultAccount.Description}
	_, err := s.CreateAccount(session, ptr, namespace)
	if err != nil {
		log.Errorf("create default account failed, namespace:%s,err:%s", namespace, err.Error())
	}
}
