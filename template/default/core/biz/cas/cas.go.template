type Cas struct {
	base.Base

	casService string
}

func NewCas(
	casService string,
	eventHub event.Hub,
	backgroundRoutine *task.BackgroundRoutine,
) *Cas {
	cas := &Cas{
		Base:       base.New("/biz/cas", eventHub, backgroundRoutine),
		casService: casService,
	}

	return cas
}

func (s *Cas) LoadNamespace() (ret []*casCommon.NamespaceLite, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	ret, err = clnt.QueryAllNamespaceLite()
	return
}

func (s *Cas) CheckNamespace(namespace string) (err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	clnt.AttachNameSpace(namespace)

	defaultAccount := casModel.DefaultSuperAccount()
	accountList, accountErr := clnt.CheckAccount(defaultAccount.Account)
	if accountErr != nil {
		err = accountErr
		return
	}

	if len(accountList) > 0 {
		return
	}

	createParam := &casCommon.AccountParam{Account: defaultAccount.Account, Password: defaultAccount.Password, EMail: defaultAccount.EMail, Description: defaultAccount.Description}
	_, err = clnt.CreateAccount(createParam)
	return
}

func (s *Cas) Login(curSession commonSession.Session, account, password, namespace string) (entityPtr *casModel.Entity, sessionInfo *commonCommon.SessionInfo, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	ctxInfo := curSession.GetSessionInfo()
	ctxInfo.Scope = commonCommon.ShareSession
	clnt.BindSession(ctxInfo)
	clnt.AttachNameSpace(namespace)

	loginEntity, loginSession, loginErr := clnt.LoginAccessAccount(account, password)
	if loginErr != nil {
		err = loginErr
		log.Errorf("login account failed, err:%s", err.Error())
		return
	}

	entityPtr = loginEntity
	sessionInfo = loginSession
	return
}

func (s *Cas) Logout(curSession commonSession.Session, namespace string) (sessionInfo *commonCommon.SessionInfo, err error) {
	sessionInfo = curSession.GetSessionInfo()
	if sessionInfo == nil {
		err = fmt.Errorf("must login first")
		return
	}

	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	clnt.BindSession(sessionInfo)
	clnt.AttachNameSpace(namespace)

	logoutSession, logoutErr := clnt.LogoutAccessAccount()
	if logoutErr != nil {
		err = logoutErr
		log.Errorf("logout account failed, err:%s", err.Error())
		return
	}

	sessionInfo = logoutSession

	return
}

