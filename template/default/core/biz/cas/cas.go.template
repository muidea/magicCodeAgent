func (s *Cas) CreateNamespace(currentSession commonSession.Session, ptr *casCommon.NamespaceParam, namespace string) (ret *casModel.Namespace, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	sessionInfo := currentSession.GetSessionInfo()
	clnt.BindSession(sessionInfo)
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.CreateNamespace(ptr)
	if err != nil {
		return
	}

	eid := strings.ReplaceAll(ed.CreateNamespace, "+", ret.Name)
	lite := casCommon.NamespaceLite{}
	lite.FromNamespace(ret)
	event := event.NewEvent(eid, s.ID(), s.RootDestination(), lite)
	s.PostEvent(event)

	s.createDefaultAccount(currentSession, lite.Name)
	return
}

func (s *Cas) UpdateNamespace(currentSession commonSession.Session, id int, ptr *casCommon.NamespaceParam, namespace string) (ret *casModel.Namespace, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()

	sessionInfo := currentSession.GetSessionInfo()
	clnt.BindSession(sessionInfo)
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.UpdateNamespace(id, ptr)
	if err != nil {
		return
	}

	eid := strings.ReplaceAll(ed.EnableNamespace, "+", ret.Name)
	lite := casCommon.NamespaceLite{}
	lite.FromNamespace(ret)
	if ret.Disable() {
		eid = strings.ReplaceAll(ed.DisableNamespace, "+", ret.Name)
	}

	event := event.NewEvent(eid, s.ID(), s.RootDestination(), lite)
	s.PostEvent(event)

	return
}

func (s *Cas) DeleteNamespace(currentSession commonSession.Session, id int, namespace string) (ret *casModel.Namespace, err error) {
	clnt := casClient.NewClient(s.casService)
