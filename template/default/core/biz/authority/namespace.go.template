package authority

import (
	"github.com/muidea/magicCas/client"
	casCommon "github.com/muidea/magicCas/common"
	casModel "github.com/muidea/magicCas/model"
	commonDef "github.com/muidea/magicCommon/def"
)

func (s *Authority) LoadNamespace() (ret []*casCommon.NamespaceLite, err error) {
	clnt := client.NewClient(s.casService)
	defer clnt.Release()

	namespaceList, namespaceTotal, namespaceErr := clnt.FilterNamespace(nil)
	if namespaceErr != nil {
		err = namespaceErr
		return
	}
	ret = []*casCommon.NamespaceLite{}
	if namespaceTotal == 0 {
		return
	}

	for _, val := range namespaceList {
		lite := &casCommon.NamespaceLite{}
		lite.FromNamespace(val)

		ret = append(ret, lite)
	}

	return
}

func (s *Authority) FilterAuthorityNamespace(filter *commonDef.Filter, namespace string) (ret []*casModel.Namespace, total int64, err error) {
	clnt := client.NewClient(s.casService)
	defer clnt.Release()

	clnt.AttachNameSpace(namespace)
	ret, total, err = clnt.FilterNamespace(filter)
	return
}

