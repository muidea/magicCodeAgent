package authority

import (
	commonDef "github.com/muidea/magicCommon/def"

	casClient "github.com/muidea/magicCas/client"
	casCommon "github.com/muidea/magicCas/common"
	casModel "github.com/muidea/magicCas/model"

	"github.com/muidea/{{.ProjectName}}/common"
)

func (s *Authority) FilterAuthorityEndpoint(filter *commonDef.Filter, namespace string) (ret []*casModel.Endpoint, total int64, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, total, err = clnt.FilterEndpoint(filter)
	return
}

func (s *Authority) QueryAuthorityEndpoint(id int, namespace string) (ret *casModel.Endpoint, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.QueryEndpoint(id)
	return
}

func (s *Authority) CreateAuthorityEndpoint(ptr *common.EndpointParam, namespace string) (ret *casModel.Endpoint, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	param := &casCommon.EndpointParam{Endpoint: ptr.Endpoint, Description: ptr.Description, IdentifyID: ptr.IdentifyID, AuthToken: ptr.AuthToken, Status: ptr.Status, Namespace: namespace}
	ret, err = clnt.CreateEndpoint(param)
	return
}

func (s *Authority) UpdateAuthorityEndpoint(ptr *common.Endpoint, namespace string) (ret *casModel.Endpoint, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	endpoint := ptr.ToEndpoint()
	endpoint.Namespace = namespace
	ret, err = clnt.UpdateEndpoint(endpoint)
	return
}

func (s *Authority) DeleteAuthorityEndpoint(id int, namespace string) (ret *casModel.Endpoint, err error) {
	clnt := casClient.NewClient(s.casService)
	defer clnt.Release()
	clnt.AttachNameSpace(namespace)

	ret, err = clnt.DeleteEndpoint(id)
	return
}
