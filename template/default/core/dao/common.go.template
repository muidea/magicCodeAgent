package dao

import (
    "fmt"
    "time"

    "github.com/muidea/magicBatis/client"
    "github.com/muidea/magicBatis/def"

    commonCommon "github.com/muidea/magicCommon/common"
    commonDef "github.com/muidea/magicCommon/def"
    fu "github.com/muidea/magicCommon/foundation/util"

    casClient "github.com/muidea/magicCas/client"
    casModel "github.com/muidea/magicCas/model"

    "github.com/muidea/{{.ProjectName}}/model"
)

// Common common dao
type Common interface {
    QueryLog(filter *def.QueryFilter, namespace string) ([]*model.Log, int64, error)
    WriteLog(address, memo string, operator int, namespace string) (*model.Log, error)

    QueryEntity(id int, sessionInfo *commonCommon.SessionInfo, namespace string) (*casModel.Entity, error)
    QueryNamespace(sessionInfo *commonCommon.SessionInfo, namespace string) (*casModel.Namespace, error)
}

// NewCommon 新建Common
func NewCommon(clnt client.Client, casService string) Common {
    return &common{batisClient: clnt, casService: casService}
}

type common struct {
    batisClient client.Client
    casService  string
}

func (s *common) QueryLog(filter *def.QueryFilter, namespace string) (ret []*model.Log, total int64, err error) {
    ret = []*model.Log{}
    if filter == nil {
        filter = def.NewFilter()
    }
    filter.SortFilter = &fu.SortFilter{AscSort: false, FieldName: "CreateTime"}
    filter.Equal("Namespace", namespace)

    total, err = s.batisClient.BatchQueryEntity(&ret, filter)
    return
}

func (s *common) WriteLog(address, memo string, operator int, namespace string) (ret *model.Log, err error) {
    ptr := &model.Log{Address: address, Memo: memo, Creater: operator, CreateTime: time.Now().UTC().Unix(), Namespace: namespace}
    err = s.batisClient.InsertEntity(ptr)
    if err == nil {
        ret = ptr
    }
    return
}

func (s *common) QueryEntity(id int, sessionInfo *commonCommon.SessionInfo, namespace string) (*casModel.Entity, error) {
    casClient := casClient.NewClient(s.casService)
    defer casClient.Release()

    casClient.BindSession(sessionInfo)
    casClient.AttachNameSpace(namespace)

    return casClient.QueryAccessEntity(id)
}

func (s *common) QueryNamespace(sessionInfo *commonCommon.SessionInfo, namespace string) (ret *casModel.Namespace, err error) {
    casClient := casClient.NewClient(s.casService)
    defer casClient.Release()

    casClient.BindSession(sessionInfo)

    filter := commonDef.NewFilter()
    filter.Set("Name", namespace)
    namespaceList, namespaceTotal, namespaceErr := casClient.FilterNamespace(filter)
    if namespaceErr != nil {
        err = namespaceErr
        return
    }
    if namespaceTotal <= 0 {
        err = fmt.Errorf("can't find namespace:%s", namespace)
        return
    }
    ret = namespaceList[0]
    return
}
