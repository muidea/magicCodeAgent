package service

import (
	"encoding/json"
	"net/http"

	"github.com/muidea/magicBatis/def"

	commonDef "github.com/muidea/magicCommon/def"
	fu "github.com/muidea/magicCommon/foundation/util"

	casCommon "github.com/muidea/magicCas/common"

	"github.com/muidea/{{.ProjectName}}/common"
)

func (s *Setting) ViewSettingProfile(res http.ResponseWriter, req *http.Request) {
	pageFilter := fu.NewPageFilter()
	pageFilter.Decode(req)

	filter := def.NewFilter()
	filter.Page(pageFilter)

	result := &common.ProfileResult{}
	for {
		curNamespace := s.getCurrentNamespace(res, req)
		curEntity, curErr := s.getCurrentEntity(res, req)
		if curErr != nil {
			result.ErrorCode = commonDef.InvalidAuthority
			result.Reason = "invalid authority"
			break
		}

		curAccount, curErr := s.settingBiz.QuerySettingProfile(curEntity, curNamespace)
		if curErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = curErr.Error()
			break
		}

		filter.Equal("Creater", curEntity.ID)
		logList, logErr := s.settingBiz.QueryOperateLog(filter, curNamespace)
		if logErr != nil {
			result.ErrorCode = commonDef.Failed
			result.Reason = logErr.Error()
			break
		}
		entityView := &casCommon.EntityView{}
		entityView.FromEntity(curEntity)
		for _, val := range logList {
			view := &common.LogView{}
			view.FromLog(val, entityView)
			result.OperateLog = append(result.OperateLog, view)
		}

		result.Profile = &casCommon.AccountView{}
		result.Profile.FromAccount(curAccount)
		result.ErrorCode = commonDef.Success
		break
	}

	block, err := json.Marshal(result)
	if err == nil {
		res.Write(block)
		return
	}

	res.WriteHeader(http.StatusExpectationFailed)
}
