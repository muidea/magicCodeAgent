package client

import (
	"fmt"
	"net/http"
	"net/url"
	"strings"

	"github.com/muidea/magicCommon/foundation/net"
	"github.com/muidea/magicCommon/foundation/util"

	casCommon "github.com/muidea/magicCas/common"
	casModel "github.com/muidea/magicCas/model"
	commonCommon "github.com/muidea/magicCommon/common"
	commonDef "github.com/muidea/magicCommon/def"

	"github.com/muidea/{{.ProjectName}}/common"
	"github.com/muidea/{{.ProjectName}}/model"
)

// Client client interface
type Client interface {
	LoginAccount(account, password string) (*casModel.Entity, *commonCommon.SessionInfo, error)
	LogoutAccount() (*commonCommon.SessionInfo, error)
	ConfirmEndpoint(identifyID, authToken string) (*casModel.Entity, *commonCommon.SessionInfo, error)
	RefreshStatus() (*casModel.Entity, *commonCommon.SessionInfo, error)

	CreateAccount(account, password string) (*casModel.AccountView, error)
	UpdateAccountPassword(account, curPassword, newPassword string) (*casModel.AccountView, error)

	QueryOpertateLog(filter *util.PageFilter) ([]*model.OpLog, int64, error)

	AttachContext(ctx commonCommon.ContextInfo)
	DetachContext()

	BindSession(sessionInfo *commonCommon.SessionInfo)
	UnBindSession()

	Release()
}

// NewClient new client
func NewClient(serverURL string) Client {
	clnt := &impl{serverURL: serverURL, httpClient: &http.Client{}}

	return clnt
}

type impl struct {
	serverURL   string
	sessionInfo *commonCommon.SessionInfo
	contextInfo commonCommon.ContextInfo
	httpClient  *http.Client
}

func (s *impl) LoginAccount(account, password string) (*casModel.Entity, *commonCommon.SessionInfo, error) {
	result := &casCommon.LoginResult{}

	vals := url.Values{}
	if s.sessionInfo != nil {
		vals = s.sessionInfo.Encode(vals)
	}
	url, _ := url.ParseRequestURI(s.serverURL)
	url.Path = strings.Join([]string{url.Path, common.LoginAccountURL}, "")
	url.RawQuery = vals.Encode()
	param := &casCommon.LoginParam{Account: account, Password: password}
	_, err := net.HTTPPost(s.httpClient, url.String(), param, result, s.getContextValues())
	if err != nil {
		return nil, s.sessionInfo, err
	}

	if result.ErrorCode != commonDef.Success {
		err = fmt.Errorf("登录失败，%s", result.Reason)
	}

	return result.Entity, result.SessionInfo, err
}

func (s *impl) LogoutAccount() (*commonCommon.SessionInfo, error) {
	result := &casCommon.LogoutResult{}

	vals := url.Values{}
	if s.sessionInfo != nil {
		vals = s.sessionInfo.Encode(vals)
	}
	url, _ := url.ParseRequestURI(s.serverURL)
	url.Path = strings.Join([]string{url.Path, common.LogoutAccountURL}, "")
	url.RawQuery = vals.Encode()
	_, err := net.HTTPDelete(s.httpClient, url.String(), result, s.getContextValues())
	if err != nil {
		return s.sessionInfo, err
	}

	if result.ErrorCode != commonDef.Success {
		err = fmt.Errorf("登出失败，%s", result.Reason)
	}

	return result.SessionInfo, err
}

func (s *impl) ConfirmEndpoint(identifyID, authToken string) (*casModel.Entity, *commonCommon.SessionInfo, error) {
	result := &casCommon.ConfirmResult{}

	vals := url.Values{}
	if s.sessionInfo != nil {
		vals = s.sessionInfo.Encode(vals)
	}
	if identifyID != "" {
		vals.Set("identifyID", identifyID)
	}
	if authToken != "" {
		vals.Set("authToken", authToken)
	}
	url, _ := url.ParseRequestURI(s.serverURL)
	url.Path = strings.Join([]string{url.Path, common.ConfirmEndpointURL}, "")
	url.RawQuery = vals.Encode()
	_, err := net.HTTPGet(s.httpClient, url.String(), result, s.getContextValues())
	if err != nil {
		return nil, s.sessionInfo, err
	}

	if result.ErrorCode != commonDef.Success {
		err = fmt.Errorf("校验终端失败，%s", result.Reason)
	}

	return result.Entity, result.SessionInfo, err
}

func (s *impl) RefreshStatus() (*casModel.Entity, *commonCommon.SessionInfo, error) {
	result := &casCommon.RefreshResult{}

	vals := url.Values{}
	if s.sessionInfo != nil {
		vals = s.sessionInfo.Encode(vals)
	}
	url, _ := url.ParseRequestURI(s.serverURL)
	url.Path = strings.Join([]string{url.Path, common.RefreshStatusURL}, "")
	url.RawQuery = vals.Encode()
	_, err := net.HTTPGet(s.httpClient, url.String(), result, s.getContextValues())
	if err != nil {
		return nil, nil, err
	}

	if result.ErrorCode != commonDef.Success {
		err = fmt.Errorf("刷新会话状态失败，%s", result.Reason)
		return nil, nil, err
	}

	return result.Entity, result.SessionInfo, nil
}

func (s *impl) CreateAccount(account, password string) (*casModel.AccountView, error) {
	result := &casCommon.CreateAccountResult{}

	vals := url.Values{}
	if s.sessionInfo != nil {
		vals = s.sessionInfo.Encode(vals)
	}
	url, _ := url.ParseRequestURI(s.serverURL)
	url.Path = strings.Join([]string{url.Path, common.CreateAccountURL}, "")
	url.RawQuery = vals.Encode()
	param := &casCommon.CreateAccountParam{Account: account, Password: password}
	_, err := net.HTTPPost(s.httpClient, url.String(), param, result, s.getContextValues())
	if err != nil {
		return nil, err
	}

	if result.ErrorCode != commonDef.Success {
		err = fmt.Errorf("新建账号失败，%s", result.Reason)
	}

	return result.Account, err
}

func (s *impl) UpdateAccountPassword(account, curPassword, newPassword string) (*casModel.AccountView, error) {
	result := &casCommon.UpdateAccountPasswordResult{}

	vals := url.Values{}
	if s.sessionInfo != nil {
		vals = s.sessionInfo.Encode(vals)
	}
	url, _ := url.ParseRequestURI(s.serverURL)
	url.Path = strings.Join([]string{url.Path, common.UpdateAccountPasswordURL}, "")
	url.RawQuery = vals.Encode()
	param := &casCommon.UpdateAccountPasswordParam{Account: account, CurPassword: curPassword, NewPassword: newPassword}
	_, err := net.HTTPPut(s.httpClient, url.String(), param, result, s.getContextValues())
	if err != nil {
		return nil, err
	}

	if result.ErrorCode != commonDef.Success {
		err = fmt.Errorf("修改密码失败，%s", result.Reason)
	}

	return result.Account, err
}

func (s *impl) QueryOpertateLog(filter *util.PageFilter) ([]*model.OpLog, int64, error) {
	result := &common.QueryAllOpertateLogResult{}

	vals := url.Values{}
	if s.sessionInfo != nil {
		vals = s.sessionInfo.Encode(vals)
	}
	if filter != nil {
		vals = filter.Encode(vals)
	}

	url, _ := url.ParseRequestURI(s.serverURL)
	url.Path = strings.Join([]string{url.Path, common.QueryOperateLogURL}, "")
	url.RawQuery = vals.Encode()
	_, err := net.HTTPGet(s.httpClient, url.String(), result, s.getContextValues())
	if err != nil {
		return nil, 0, err
	}

	if result.ErrorCode != commonDef.Success {
		err = fmt.Errorf("查询日志失败，%s", result.Reason)
	}

	return result.Logs, result.Total, err
}

func (s *impl) AttachContext(ctx commonCommon.ContextInfo) {
	s.contextInfo = ctx
}

func (s *impl) DetachContext() {
	s.contextInfo = nil
}

func (s *impl) getContextValues() url.Values {
	ret := url.Values{}
	if s.contextInfo != nil {
		ret = s.contextInfo.Encode(ret)
	}

	return ret
}

func (s *impl) BindSession(sessionInfo *commonCommon.SessionInfo) {
	s.sessionInfo = sessionInfo
}

func (s *impl) UnBindSession() {
	s.sessionInfo = nil
}

func (s *impl) Release() {
	if s.httpClient != nil {
		s.httpClient.CloseIdleConnections()
		s.httpClient = nil
	}
}
