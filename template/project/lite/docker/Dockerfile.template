FROM alpine:3.13.4

LABEL Author="rangh"
LABEL Application="{{.ProjectName}}"

RUN mkdir -p /var/app
RUN mkdir -p /var/app/config

WORKDIR /var/app

ADD {{.ProjectName}} /var/app/{{.ProjectName}}
ADD bootstrap.sh /var/app/bootstrap.sh
ADD cfg.json /var/app/config/cfg.json

RUN chmod +x /var/app/{{.ProjectName}}
RUN chmod +x /var/app/bootstrap.sh

ENTRYPOINT [ "/var/app/bootstrap.sh" ]

EXPOSE 8880
