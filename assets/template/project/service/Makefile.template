export PATH := $(GOPATH)/bin:$(PATH)
export GO111MODULE=on
LDFLAGS := -X 'main.buildTime=$(shell date -u +"%Y-%m-%d %H:%M:%S UTC")' -X 'main.gitCommit=$(shell git log --pretty=format:"%h" -1)' -X 'main.version=$(shell git describe --tags --exact-match 2>/dev/null || echo "v0.0.0")'
PROJECT={{.ProjectName}}

all: fmt build

build:
	env CGO_ENABLED=0 go build -ldflags "$(LDFLAGS)" -o bin/{{.ProjectName}} ./application/{{.ProjectName}}/cmd

fmt:
	go fmt ./...

vet:
	go vet ./...

clean:
	rm -f ./bin/$(PROJECT)
