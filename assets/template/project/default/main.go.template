package main

import (
	"flag"
	"fmt"
	"net/http"
	_ "net/http/pprof"

	"github.com/muidea/magicCommon/foundation/log"

	"github.com/muidea/magicCommon/application"

	"github.com/muidea/{{.ProjectName}}/config"
	"github.com/muidea/{{.ProjectName}}/core"
)

var listenPort = "8080"
var endpointName = "{{toLower .ProjectName}}"

func initPprofWorkspace(listenPort string) error {
	var err error
	addr := ":1" + listenPort

	go func() {
		err = http.ListenAndServe(addr, nil)
		if err != nil {
			log.Critical("funcRetErr=http.ListenAndServe||err=%s", err.Error())
		}
	}()

	return err
}

func main() {
	flag.StringVar(&listenPort, "ListenPort", listenPort, "{{.ProjectName}} listen address")
	flag.StringVar(&endpointName, "EndpointName", endpointName, "application endpoint name.")
	flag.Parse()

	initPprofWorkspace(listenPort)

	fmt.Printf("{{.ProjectName}} V1.0\n")

	config.UpdateLocalInfo(endpointName, listenPort)
	core, err := core.New(endpointName, listenPort)
	if err != nil {
		log.Errorf("create core service failed, err:%s", err.Error())
		return
	}

	application.Startup(core)
	application.Run()
	application.Shutdown()
}
