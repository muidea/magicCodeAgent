import axios from "axios";

// 定义日志级别
type LogLevel = "log" | "info" | "warn" | "error" | "exception" | "network";

// 原始 console 方法
const originalConsole = {
  log: console.log,
  info: console.info,
  warn: console.warn,
  error: console.error,
};

// 发送日志到后端
const sendLogToServer = (
  level: LogLevel,
  message: unknown,
  extraData?: unknown
) => {
  if (level !== "exception") {
    return;
  }

  const payload = {
    level,
    timestamp: new Date().toISOString(),
    message: typeof message === "string" ? message : JSON.stringify(message),
    extraData: extraData !== undefined && extraData !== null ? extraData : null,
  };

  axios.post("/api/v1/console/logs", payload).catch((err) => {
    originalConsole.error("Failed to send log:", err);
  });
};

// 解析错误堆栈，提取文件名、行号、列号
const parseStackTrace = (stack: string) => {
  const stackLines = stack.split("\n");
  const relevantLine = stackLines.find(
    (line) => line.includes(".ts") || line.includes(".js")
  );
  if (!relevantLine) return null;

  const match = relevantLine.match(/(.*?):(\d+):(\d+)/);
  if (match) {
    return {
      file: match[1],
      line: parseInt(match[2], 10),
      column: parseInt(match[3], 10),
    };
  }
  return null;
};

// 捕获全局未捕获的错误
const handleGlobalErrors = () => {
  window.onerror = (message, source, lineno, colno, error) => {
    const stackInfo = error?.stack ? parseStackTrace(error.stack) : null;
    sendLogToServer("exception", message, {
      source,
      lineno,
      colno,
      stack: error?.stack || null,
      parsedStack: stackInfo,
    });
  };

  window.onunhandledrejection = (event) => {
    const reason = event.reason || "Unhandled Promise Rejection";
    const stackInfo = reason?.stack ? parseStackTrace(reason.stack) : null;
    sendLogToServer("exception", reason, {
      stack: reason?.stack || null,
      parsedStack: stackInfo,
    });
  };
};

// 拦截网络请求错误
const interceptNetworkRequests = () => {
  const originalFetch = window.fetch;
  window.fetch = async (input: RequestInfo | URL, init?: RequestInit) => {
    try {
      const response = await originalFetch(input, init);
      if (!response.ok) {
        sendLogToServer("network", `HTTP Error: ${response.status}`, {
          url: input,
          status: response.status,
          statusText: response.statusText,
        });
      }
      return response;
    } catch (error) {
      sendLogToServer("network", "Network Request Failed", {
        url: input,
        error,
      });
      throw error;
    }
  };

  const originalXhrOpen = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function (
    method: string,
    url: string | URL,
    async: boolean = true,
    username?: string | null,
    password?: string | null
  ) {
    this.addEventListener("error", () => {
      sendLogToServer("network", "XMLHttpRequest Error", { url });
    });
    this.addEventListener("abort", () => {
      sendLogToServer("network", "XMLHttpRequest Aborted", { url });
    });
    originalXhrOpen.call(this, method, url, async, username, password);
  };
};

// 初始化日志模块
const initLogger = () => {
  interceptConsole();
  handleGlobalErrors();
  interceptNetworkRequests();
};

// 拦截 console 方法
const interceptConsole = () => {
  ["log", "info", "warn", "error"].forEach((level) => {
    const originalMethod = (
      originalConsole as unknown as Record<string, (...args: unknown[]) => void>
    )[level];
    (console as unknown as Record<string, (...args: unknown[]) => void>)[
      level
    ] = (...args: unknown[]) => {
      originalMethod.apply(console, args);
      sendLogToServer(level as LogLevel, args);
    };
  });
};

initLogger();

export default initLogger;
