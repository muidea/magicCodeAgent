body {
  margin: 0;
  padding: 0;
}

.ant-pro-page-container {
  .ant-pro-page-container-warp {
    background-color: #fff;
  }
}

// 表格样式优化
.ant-table {
  .ant-table-thead > tr > th {
    background-color: #f5f5f5;
  }
}

// 卡片样式优化
.ant-card {
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  margin-bottom: 16px;
}

// 标签样式
.ant-tag {
  margin-right: 8px;
  margin-bottom: 8px;
}